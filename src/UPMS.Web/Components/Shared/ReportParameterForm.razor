@inject IItsmSourceService ItsmSourceService
@inject ICanonicalFieldService CanonicalFieldService
@inject ICanonicalValueSuggestionService CanonicalValueSuggestionService

<div class="report-parameter-grid">
    @foreach (var param in Parameters)
    {
        var fromKey = param.Key + "_from";
        var toKey = param.Key + "_to";
        var suggestionListId = GetSuggestionListId(param);
        var suggestions = GetValueSuggestions(param);

        <div class="@GetFieldClass(param)">
            <label for="@param.Key">
                @param.DisplayName
                @if (param.IsRequired)
                {
                    <span class="required-mark">*</span>
                }
            </label>

            @if (!string.IsNullOrWhiteSpace(param.Description))
            {
                <div class="field-help">@param.Description</div>
            }

            @if (param.Type == ReportParameterType.Text)
            {
                if (TryGetCanonicalDataType(param, out var canonicalDataType) && canonicalDataType == CanonicalFieldDataType.Boolean)
                {
                    <select id="@param.Key"
                            class="form-select"
                            @onchange="e => SetValue(param.Key, e.Value?.ToString() ?? string.Empty)">
                        <option value="">-- Select --</option>
                        <option value="true" selected="@(GetValue(param.Key) == "true")">True</option>
                        <option value="false" selected="@(GetValue(param.Key) == "false")">False</option>
                    </select>
                }
                else
                {
                    <input id="@param.Key"
                           class="form-control"
                           type="@GetTextInputType(param)"
                           value="@GetRenderedTextValue(param)"
                           placeholder="@GetPlaceholder(param)"
                           list="@(ShouldUseSuggestionList(param) ? suggestionListId : null)"
                           @onfocus="() => LoadSuggestionsAsync(param)"
                           @onchange="e => SetValue(param.Key, e.Value?.ToString() ?? string.Empty)" />

                    @if (ShouldUseSuggestionList(param) && suggestions.Count > 0)
                    {
                        <datalist id="@suggestionListId">
                            @foreach (var suggestion in suggestions)
                            {
                                <option value="@suggestion"></option>
                            }
                        </datalist>
                    }
                }
            }
            else if (param.Type == ReportParameterType.TextArea)
            {
                <textarea id="@param.Key"
                          class="form-control"
                          rows="5"
                          placeholder="@GetPlaceholder(param)"
                          @onchange="e => SetValue(param.Key, e.Value?.ToString() ?? string.Empty)">@GetValue(param.Key)</textarea>
            }
            else if (param.Type == ReportParameterType.Date)
            {
                <input id="@param.Key"
                       class="form-control"
                       type="date"
                       value="@GetValue(param.Key)"
                       @onchange="e => SetValue(param.Key, e.Value?.ToString() ?? string.Empty)" />
            }
            else if (param.Type == ReportParameterType.ItsmSource)
            {
                <select id="@param.Key"
                        class="form-select"
                        @onchange="e => SetValue(param.Key, e.Value?.ToString() ?? string.Empty)">
                    <option value="">-- Select --</option>

                    @if (itsmSources.Count == 0)
                    {
                        <option value="" disabled>(No ITSM sources defined)</option>
                    }
                    else
                    {
                        @foreach (var src in itsmSources)
                        {
                            <option value="@src.Name" selected="@(GetValue(param.Key) == src.Name)">@src.DisplayLabel (@src.Name)</option>
                        }
                    }
                </select>
            }
            else if (param.Type == ReportParameterType.Select)
            {
                <select id="@param.Key"
                        class="form-select"
                        @onchange="e => SetValue(param.Key, e.Value?.ToString() ?? string.Empty)">
                    <option value="">-- Select --</option>
                    @foreach (var option in param.Options ?? Array.Empty<string>())
                    {
                        <option value="@option" selected="@(GetValue(param.Key) == option)">@option</option>
                    }
                </select>
            }
            else if (param.Type == ReportParameterType.MultiSelect)
            {
                var selectedOptions = GetMultiSelectValues(param.Key);
                <div class="multi-select">
                    @if ((param.Options?.Count ?? 0) == 0)
                    {
                        <div class="text-muted small">No options available.</div>
                    }
                    else
                    {
                        @for (var i = 0; i < (param.Options?.Count ?? 0); i++)
                        {
                            var option = param.Options![i];
                            var id = $"{param.Key}_{i}";
                            var isChecked = selectedOptions.Contains(option);

                            <label class="multi-select-option" for="@id">
                                <input id="@id"
                                       type="checkbox"
                                       checked="@isChecked"
                                       @onchange="e => OnMultiSelectChanged(param.Key, option, e.Value)" />
                                <span>@option</span>
                            </label>
                        }
                    }
                </div>
            }
            else if (param.Type == ReportParameterType.Boolean)
            {
                var isChecked = GetValue(param.Key) == "true";
                <label class="multi-select-option" for="@param.Key">
                    <input id="@param.Key"
                           type="checkbox"
                           checked="@isChecked"
                           @onchange="e => OnBooleanChanged(param.Key, e.Value)" />
                    <span>Enabled</span>
                </label>
            }
            else if (param.Type == ReportParameterType.DateRange)
            {
                <div class="date-range">
                    <div class="field-stack">
                        <label for="@fromKey">From</label>
                        <input id="@fromKey"
                               class="form-control"
                               type="date"
                               value="@GetValue(fromKey)"
                               @onchange="e => SetValue(fromKey, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="field-stack">
                        <label for="@toKey">To</label>
                        <input id="@toKey"
                               class="form-control"
                               type="date"
                               value="@GetValue(toKey)"
                               @onchange="e => SetValue(toKey, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<ReportParameterDefinition> Parameters { get; set; } = Array.Empty<ReportParameterDefinition>();
    [Parameter] public Dictionary<string, string> Values { get; set; } = new();
    [Parameter] public EventCallback OnValuesChanged { get; set; }

    private IReadOnlyList<ItsmSource> itsmSources = Array.Empty<ItsmSource>();
    private IReadOnlyDictionary<string, CanonicalFieldDefinition> canonicalFields = new Dictionary<string, CanonicalFieldDefinition>(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<string>> suggestionCache = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            itsmSources = (await ItsmSourceService.GetAllSourcesAsync())
                .OrderBy(s => s.DisplayLabel)
                .ThenBy(s => s.Name)
                .ToList();
        }
        catch
        {
            itsmSources = Array.Empty<ItsmSource>();
        }

        try
        {
            canonicalFields = (await CanonicalFieldService.GetLookupAsync())
                .ToDictionary(kvp => kvp.Key, kvp => kvp.Value, StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            canonicalFields = new Dictionary<string, CanonicalFieldDefinition>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private static string GetFieldClass(ReportParameterDefinition param)
    {
        return param.Type is ReportParameterType.TextArea or ReportParameterType.MultiSelect or ReportParameterType.DateRange
            ? "parameter-field parameter-field--full"
            : "parameter-field";
    }

    private string GetValue(string key) =>
        Values.TryGetValue(key, out var v) ? v : string.Empty;

    private async Task SetValue(string key, string value)
    {
        Values[key] = value;

        if (string.Equals(key, "itsm_source", StringComparison.OrdinalIgnoreCase))
        {
            suggestionCache.Clear();
        }

        await OnValuesChanged.InvokeAsync();
    }

    private async Task OnBooleanChanged(string key, object? value)
    {
        var boolValue = value is bool b && b;
        await SetValue(key, boolValue ? "true" : "false");
    }

    private HashSet<string> GetMultiSelectValues(string key)
    {
        var raw = GetValue(key);
        if (string.IsNullOrWhiteSpace(raw))
            return new HashSet<string>(StringComparer.Ordinal);

        var parts = raw
            .Split([',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return new HashSet<string>(parts, StringComparer.Ordinal);
    }

    private async Task OnMultiSelectChanged(string key, string option, object? value)
    {
        var isChecked = value is bool b && b;
        var selected = GetMultiSelectValues(key);

        if (isChecked)
            selected.Add(option);
        else
            selected.Remove(option);

        string serialized;
        var param = Parameters.FirstOrDefault(p => p.Key == key);
        if (param?.Options is { Count: > 0 } options)
        {
            serialized = string.Join(",", options.Where(selected.Contains));
        }
        else
        {
            serialized = string.Join(",", selected.OrderBy(x => x));
        }

        await SetValue(key, serialized);
    }

    private bool TryGetCanonicalDataType(ReportParameterDefinition param, out CanonicalFieldDataType dataType)
    {
        dataType = CanonicalFieldDataType.Text;

        if (string.IsNullOrWhiteSpace(param.CanonicalFieldName))
            return false;

        if (!canonicalFields.TryGetValue(param.CanonicalFieldName, out var definition))
            return false;

        dataType = definition.DataType;
        return true;
    }

    private string GetTextInputType(ReportParameterDefinition param)
    {
        if (!TryGetCanonicalDataType(param, out var dataType))
            return "text";

        return dataType switch
        {
            CanonicalFieldDataType.Integer => "number",
            CanonicalFieldDataType.Decimal => "number",
            CanonicalFieldDataType.DateTime => "datetime-local",
            _ => "text"
        };
    }

    private string GetRenderedTextValue(ReportParameterDefinition param)
    {
        var value = GetValue(param.Key);
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        if (TryGetCanonicalDataType(param, out var dataType)
            && dataType == CanonicalFieldDataType.DateTime
            && DateTime.TryParse(value, out var parsed))
        {
            return parsed.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);
        }

        return value;
    }

    private string GetPlaceholder(ReportParameterDefinition param)
    {
        if (!string.IsNullOrWhiteSpace(param.Placeholder))
            return param.Placeholder!;

        if (string.Equals(param.CanonicalFieldName, "Company", StringComparison.OrdinalIgnoreCase))
            return "Start typing to see known company names";

        return string.Empty;
    }

    private bool ShouldUseSuggestionList(ReportParameterDefinition param)
    {
        return param.Type == ReportParameterType.Text
            && param.EnableSuggestions
            && string.Equals(GetTextInputType(param), "text", StringComparison.Ordinal)
            && !string.IsNullOrWhiteSpace(param.CanonicalFieldName);
    }

    private string GetSuggestionListId(ReportParameterDefinition param) => $"suggestions-{param.Key}";

    private IReadOnlyList<string> GetValueSuggestions(ReportParameterDefinition param)
    {
        if (suggestionCache.TryGetValue(param.Key, out var cached))
            return cached;

        return Array.Empty<string>();
    }

    private async Task LoadSuggestionsAsync(ReportParameterDefinition param)
    {
        if (!ShouldUseSuggestionList(param) || string.IsNullOrWhiteSpace(param.CanonicalFieldName))
            return;

        var sources = GetCurrentItsmSources();
        suggestionCache[param.Key] = await CanonicalValueSuggestionService.GetSuggestionsAsync(param.CanonicalFieldName!, sources);
        StateHasChanged();
    }

    private IReadOnlyList<string> GetCurrentItsmSources()
    {
        if (!Values.TryGetValue("itsm_source", out var itsmSource) || string.IsNullOrWhiteSpace(itsmSource))
            return Array.Empty<string>();

        return [itsmSource.Trim()];
    }
}
