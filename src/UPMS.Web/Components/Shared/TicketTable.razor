@using System.Globalization

<div class="ticket-table-shell">
    @if (ShowColumnManager)
    {
        <section class="surface-card column-manager">
            <div class="surface-card-header">
                <div>
                    <h2 class="surface-card-title">Visible columns</h2>
                    <p class="surface-card-subtitle">Tailor the ticket table to the fields you care about most before you open a ticket.</p>
                </div>
                <button type="button" class="btn btn-outline-primary" data-testid="add-column-btn" @onclick="AddColumn">Add column</button>
            </div>

            <div class="column-manager-grid">
                @foreach (var col in fieldColumns.Select((column, index) => new { column, index }))
                {
                    var i = col.index;
                    <div class="column-row-card" @key="col.column.Id">
                        <div class="form-grid" style="grid-template-columns: minmax(160px, 220px) minmax(220px, 1fr) auto; align-items: end;">
                            <div class="field-stack">
                                <label class="form-label" for="col-mode-@i">Type</label>
                                <select id="col-mode-@i" class="form-select" data-testid="ticket-column-mode-@i" @bind="col.column.Mode">
                                    <option value="@FieldNameMode.Canonical">Canonical</option>
                                    <option value="@FieldNameMode.Custom">Custom</option>
                                </select>
                            </div>

                            @if (col.column.Mode == FieldNameMode.Canonical)
                            {
                                <div class="field-stack">
                                    <label class="form-label" for="col-canonical-@i">Field</label>
                                    <select id="col-canonical-@i" class="form-select" data-testid="ticket-column-field-@i" @bind="col.column.CanonicalFieldName">
                                        <option value="" disabled>-- Select field --</option>
                                        @foreach (var option in GetCanonicalOptionsForColumn(col.column))
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="field-stack">
                                    <label class="form-label" for="col-custom-@i">Field</label>
                                    <input id="col-custom-@i" class="form-control" data-testid="ticket-column-custom-field-@i" placeholder="e.g. u_custom_field" @bind="col.column.CustomFieldName" />
                                </div>
                            }

                            <div class="field-stack">
                                <button type="button" class="btn btn-outline-secondary" data-testid="remove-column-@i" @onclick="() => RemoveColumn(col.column)" disabled="@(fieldColumns.Count == 1)">Remove</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <div class="data-table-wrap">
        <table class="table table-hover align-middle data-table" data-testid="@TableTestId">
            <thead>
                <tr>
                    <th>Ticket Key</th>
                    <th>Company</th>
                    <th>ITSM Source</th>
                    @foreach (var col in fieldColumns)
                    {
                        <th>@GetColumnHeader(col)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Tickets is null || Tickets.Count == 0)
                {
                    <tr data-testid="@EmptyRowTestId">
                        <td colspan="@(3 + fieldColumns.Count)">
                            <div class="empty-state">
                                <p class="empty-state-title">Nothing to show yet</p>
                                <p class="empty-state-text">@EmptyMessage</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var ticket in Tickets)
                    {
                        var ticketNumber = TryGetFieldValue(ticket.Fields, "ticket_number") ?? TryGetFieldValue(ticket.Fields, "Number");
                        <tr>
                            <td class="key-cell">
                                <a class="ticket-link" href="@BuildTicketLink(ticket)">@(string.IsNullOrWhiteSpace(ticketNumber) ? ticket.TicketKey : ticketNumber)</a>
                                @if (!string.IsNullOrWhiteSpace(ticketNumber) && !string.Equals(ticketNumber, ticket.TicketKey, StringComparison.Ordinal))
                                {
                                    <div class="ticket-meta">@ticket.TicketKey</div>
                                }
                            </td>
                            <td>@ticket.CompanyName</td>
                            <td><span class="badge-soft badge-soft-neutral">@ticket.ItsmSource</span></td>

                            @foreach (var col in fieldColumns)
                            {
                                var fieldKey = col.GetEffectiveFieldName();
                                <td>@GetFieldValueOrDash(ticket, fieldKey)</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<Ticket> Tickets { get; set; } = Array.Empty<Ticket>();

    [Parameter]
    public DateTime AsOfUtc { get; set; } = DateTime.UtcNow;

    [Parameter]
    public string TableTestId { get; set; } = "ticket-table";

    [Parameter]
    public string EmptyRowTestId { get; set; } = "ticket-table-empty";

    [Parameter]
    public string EmptyMessage { get; set; } = "No tickets found.";

    [Parameter]
    public IReadOnlyList<string> CanonicalFieldOptions { get; set; } = Array.Empty<string>();

    [Parameter]
    public bool ShowColumnManager { get; set; } = true;

    private readonly List<TicketFieldColumn> fieldColumns = new();

    private enum FieldNameMode
    {
        Canonical,
        Custom
    }

    private sealed class TicketFieldColumn
    {
        public Guid Id { get; } = Guid.NewGuid();
        public FieldNameMode Mode { get; set; } = FieldNameMode.Canonical;
        public string CanonicalFieldName { get; set; } = string.Empty;
        public string CustomFieldName { get; set; } = string.Empty;

        public string GetEffectiveFieldName()
        {
            return Mode == FieldNameMode.Custom
                ? (CustomFieldName ?? string.Empty).Trim()
                : (CanonicalFieldName ?? string.Empty).Trim();
        }
    }

    protected override void OnInitialized()
    {
        if (fieldColumns.Count == 0)
        {
            fieldColumns.Add(new TicketFieldColumn
            {
                Mode = FieldNameMode.Canonical,
                CanonicalFieldName = "status"
            });
        }
    }

    private void AddColumn()
    {
        fieldColumns.Add(new TicketFieldColumn());
    }

    private void RemoveColumn(TicketFieldColumn col)
    {
        if (col is null)
            return;

        if (fieldColumns.Count <= 1)
            return;

        fieldColumns.Remove(col);
    }

    private IReadOnlyList<string> GetCanonicalOptionsForColumn(TicketFieldColumn col)
    {
        var options = new List<string>();
        var seen = new HashSet<string>(StringComparer.Ordinal);

        foreach (var o in CanonicalFieldOptions)
        {
            if (string.IsNullOrWhiteSpace(o))
                continue;

            if (seen.Add(o))
                options.Add(o);
        }

        if (col is not null && !string.IsNullOrWhiteSpace(col.CanonicalFieldName) && seen.Add(col.CanonicalFieldName))
        {
            options.Add(col.CanonicalFieldName);
        }

        if (seen.Add("State"))
            options.Add("State");
        if (seen.Add("status"))
            options.Add("status");

        return options;
    }

    private string GetColumnHeader(TicketFieldColumn col)
    {
        if (col is null)
            return "Field";

        var fieldName = col.GetEffectiveFieldName();
        if (string.IsNullOrWhiteSpace(fieldName))
            return "Field";

        if (string.Equals(fieldName, "status", StringComparison.OrdinalIgnoreCase))
            return "Status";
        if (string.Equals(fieldName, "State", StringComparison.OrdinalIgnoreCase))
            return "State";

        if (col.Mode == FieldNameMode.Custom)
            return fieldName;

        return fieldName;
    }

    private string BuildTicketLink(Ticket ticket)
    {
        var asOfQuery = DateTime.SpecifyKind(AsOfUtc, DateTimeKind.Utc)
            .ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);

        return $"/tickets/{Uri.EscapeDataString(ticket.CompanyName)}/{Uri.EscapeDataString(ticket.ItsmSource)}/{Uri.EscapeDataString(ticket.TicketKey)}?asOf={Uri.EscapeDataString(asOfQuery)}";
    }

    private static string GetFieldValueOrDash(Ticket ticket, string fieldKey)
    {
        if (ticket is null)
            return "-";

        if (string.IsNullOrWhiteSpace(fieldKey))
            return "-";

        var v = TryGetFieldValue(ticket.Fields, fieldKey);
        return string.IsNullOrWhiteSpace(v) ? "-" : v;
    }

    private static string? TryGetFieldValue(IDictionary<string, string?> fields, string fieldName)
    {
        if (fields.TryGetValue(fieldName, out var v))
            return v;

        foreach (var kv in fields)
        {
            if (string.Equals(kv.Key, fieldName, StringComparison.OrdinalIgnoreCase))
                return kv.Value;
        }

        return null;
    }
}
