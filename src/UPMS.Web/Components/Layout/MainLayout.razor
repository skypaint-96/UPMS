@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="app-shell">
    <header class="app-navbar">
        <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Primary navigation">
            <div class="container-xxl">
                <NavLink class="navbar-brand" href="/" Match="NavLinkMatch.All">
                    <span class="brand-mark">UP</span>
                    <span class="brand-copy">
                        <span class="brand-name">UPMS</span>
                        <span class="brand-tagline">Unified Problem Management System</span>
                    </span>
                </NavLink>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#upmsNavbar" aria-controls="upmsNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="upmsNavbar">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Home</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/tickets">Tickets</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/snapshots">Snapshots</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/upload">Upload</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/reports">Reports</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/report-templates">Templates</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="/itsm-sources">ITSM Sources</NavLink>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="container-xxl app-page py-4">
        @Body
    </main>

    <footer class="app-footer">
        <div class="container-xxl">
            <div>
                <strong>UPMS</strong>
                <span class="text-muted ms-2">Historical problem management and reporting in one place.</span>
            </div>
            <div class="text-muted">Blazor Server interface tuned for clearer workflows and faster scanning.</div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
