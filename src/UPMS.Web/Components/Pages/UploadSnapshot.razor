@page "/upload-snapshot"

@using UPMS.Data
@using System.ComponentModel.DataAnnotations

<PageTitle>Upload Snapshot</PageTitle>

<h3>Upload Snapshot</h3>

<EditForm Model="@model" OnValidSubmit="UploadSnapshotAsync" FormName="UploadSnapshotForm">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div>
        <label>ITSM Source:</label>
        <InputText @bind-Value="model.ItsmSource" name="ItsmSource" />
    </div>
    <div>
        <label>Snapshot Date:</label>
        <InputDate @bind-Value="model.SnapshotDate" name="SnapshotDate" />
    </div>
    <div>
        <label>Upload Metadata (optional):</label>
        <InputText @bind-Value="model.UploadMetadata" name="UploadMetadata" />
    </div>
    <div>
        <label>Tickets (CSV: TicketKey,CompanyName):</label>
        <InputTextArea @bind-Value="model.TicketsCsv" name="TicketsCsv" rows="5" />
        <div class="form-text">Example: T1,CompanyA</div>
    </div>
    <button type="submit">Upload</button>
</EditForm>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <p>@statusMessage</p>
}
@if (!string.IsNullOrEmpty(csvError))
{
    <div class="validation-message">@csvError</div>
    <div class="form-text">CSV must have lines in the format: TicketKey,CompanyName</div>
}

@code {
    private UploadSnapshotModel model = new();
    private string? statusMessage;
    private string? csvError;

    [Inject]
    private TicketDataServiceInstance DataService { get; set; } = default!;

    private async Task UploadSnapshotAsync()
    {
        csvError = null;
        var tickets = ParseTicketsCsv(model.TicketsCsv, out var parseError);
        if (parseError != null)
        {
            csvError = parseError;
            statusMessage = null;
            return;
        }
        try
        {
            var snapshotId = await DataService.CreateSnapshotAsync(
                model.ItsmSource,
                model.SnapshotDate,
                "user", // TODO: Replace with actual user
                model.UploadMetadata);

            if (tickets.Count > 0)
            {
                await DataService.AddTicketsToSnapshotAsync(snapshotId, tickets);
            }
            statusMessage = $"Snapshot uploaded. ID: {snapshotId}";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
        }
    }

    private static List<(string TicketKey, string CompanyName)> ParseTicketsCsv(string? csv, out string? error)
    {
        error = null;
        if (string.IsNullOrWhiteSpace(csv)) return new();
        var lines = csv.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var tickets = new List<(string, string)>(lines.Length);
        int lineNum = 1;
        foreach (var line in lines)
        {
            var parts = line.Split(',', 2);
            if (parts.Length != 2 || string.IsNullOrWhiteSpace(parts[0]) || string.IsNullOrWhiteSpace(parts[1]))
            {
                error = $"Error: Invalid CSV format on line {lineNum}. Each line must be: TicketKey,CompanyName";
                return new();
            }
            tickets.Add((parts[0].Trim(), parts[1].Trim()));
            lineNum++;
        }
        return tickets;
    }

    public class UploadSnapshotModel
    {
        [Required]
        public string ItsmSource { get; set; } = string.Empty;
        [Required]
        public DateTime SnapshotDate { get; set; } = DateTime.UtcNow;
        public string? UploadMetadata { get; set; }
        public string? TicketsCsv { get; set; }
    }
}
