@page "/itsm-sources/{SourceName}"
@rendermode InteractiveServer

@using UPMS.Data
@using UPMS.Web.Services

@inject IItsmSourceService ItsmSourceService
@inject ICanonicalFieldService CanonicalFieldService
@inject IUpmsArchiveService ArchiveService
@inject NavigationManager Navigation

<PageTitle>@(source?.DisplayLabel ?? SourceName) - ITSM Sources - UPMS</PageTitle>

<div class="page-shell stack-xl">
    <a class="breadcrumb-link" href="/itsm-sources" data-testid="back-to-sources">← Back to ITSM Sources</a>

    @if (source is null)
    {
        <section class="card-surface stack-md">
            <div class="page-header-body stack-sm">
                <div class="eyebrow">Configuration</div>
                <h1>ITSM Source</h1>
                <p data-testid="source-not-found">ITSM source '@SourceName' was not found.</p>
            </div>
            <div class="button-row">
                <a class="btn btn-primary" href="/itsm-sources">Return to sources</a>
            </div>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(pageMessage))
        {
            <div class="@(pageMessageIsError ? "alert alert-danger" : "alert alert-success")" role="alert">
                @pageMessage
            </div>
        }

        <section class="page-header card-surface page-header-accent">
            <div class="page-header-body stack-md">
                <div class="stack-sm">
                    <div class="eyebrow">Source configuration</div>
                    <h1 data-testid="source-display-name">@source.DisplayLabel</h1>
                    <p>
                        Review the source identity below, then map incoming source fields to registered canonical UPMS fields.
                        Each mapping now preserves the original input field name while showing the canonical name as the display label.
                    </p>
                </div>

                <div class="metadata-pills">
                    <span class="badge badge-muted">Slug: <code data-testid="source-slug">@source.Name</code></span>
                    <span class="badge badge-info">@MappingCountLabel</span>
                    <span class="badge badge-success">@RequiredCountLabel</span>
                </div>
            </div>

            <div class="page-header-actions">
                <a class="btn btn-secondary" href="/api/export/itsm-sources/@source.Name">Export full archive</a>
                <a class="btn btn-secondary" href="#add-mapping-form">Add field mapping</a>
            </div>
        </section>

        <div class="stat-grid compact-stats">
            <article class="stat-card">
                <span class="stat-label">Mapped fields</span>
                <strong>@mappings.Count</strong>
                <span class="stat-caption">Source columns currently translated into UPMS fields.</span>
            </article>
            <article class="stat-card">
                <span class="stat-label">Required fields</span>
                <strong>@mappings.Count(m => m.IsRequired)</strong>
                <span class="stat-caption">Mandatory fields that must be present during import.</span>
            </article>
            <article class="stat-card">
                <span class="stat-label">Registered canonical fields</span>
                <strong>@canonicalFields.Count</strong>
                <span class="stat-caption">Available names and datatypes from the canonical registry.</span>
            </article>
        </div>

        <div class="content-grid content-grid-sidebar-right">
            <section class="card-surface stack-md">
                <div class="section-heading">
                    <div>
                        <h2 class="section-title">Field mappings</h2>
                        <p class="section-subtitle">Original source field names are preserved; canonical names are used as the display and validation layer.</p>
                    </div>
                </div>

                <div data-testid="mappings-table">
                    @if (mappings.Count == 0)
                    {
                        <div class="empty-state" data-testid="no-mappings-message">
                            <div class="empty-state-icon">🗂️</div>
                            <div class="stack-xs">
                                <h3>No field mappings defined</h3>
                                <p>
                                    Add at least <code>Company</code> and <code>Number</code>, then map the fields that drive
                                    search, history, and reporting such as status, title, priority, and dates.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="data-table table-hover">
                                <thead>
                                    <tr>
                                        <th>Source Field Name</th>
                                        <th>Canonical Name</th>
                                        <th>Data Type</th>
                                        <th>Required</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mapping in mappings.OrderBy(m => m.SourceFieldName, StringComparer.OrdinalIgnoreCase))
                                    {
                                        var definition = GetCanonicalField(mapping.CanonicalFieldName);
                                        <tr data-testid="mapping-row-@mapping.SourceFieldName">
                                            <td>
                                                <div class="stack-xs">
                                                    <span>@mapping.SourceFieldName</span>
                                                    <span class="table-meta">Original incoming field name from the source export.</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="stack-xs">
                                                    <span class="badge badge-muted">@mapping.CanonicalFieldName</span>
                                                    @if (definition?.IsSystemRequired == true)
                                                    {
                                                        <span class="table-meta">Locked by the ticket-key system.</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                @if (definition is not null)
                                                {
                                                    <span class="badge badge-info">@definition.DataType</span>
                                                }
                                                else
                                                {
                                                    <span class="table-meta">Unknown</span>
                                                }
                                            </td>
                                            <td>
                                                @if (mapping.IsRequired)
                                                {
                                                    <span class="badge badge-success" data-testid="required-badge-@mapping.SourceFieldName">Required</span>
                                                }
                                                else
                                                {
                                                    <span class="table-meta">Optional</span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-danger btn-sm"
                                                        data-testid="delete-mapping-@mapping.SourceFieldName"
                                                        @onclick="() => DeleteMappingAsync(mapping.SourceFieldName)">
                                                    Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>

            <aside class="stack-md">
                <section class="card-surface stack-md" id="add-mapping-form">
                    <div class="section-heading">
                        <div>
                            <h2 class="section-title">Add field mapping</h2>
                            <p class="section-subtitle">Map source fields to canonical names and datatypes used throughout UPMS.</p>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <strong>Tip:</strong> map the source ticket identifier to <code>Number</code> and the owning tenant to <code>Company</code>.
                        UPMS derives the internal <code>ticket_key</code> as <code>{itsmSource}::{company}::{number}</code> without storing it as a ticket field.
                    </div>

                    @if (!string.IsNullOrEmpty(addMappingError))
                    {
                        <div class="alert alert-danger" data-testid="add-mapping-error" role="alert">@addMappingError</div>
                    }

                    <div class="form-grid">
                        <div class="form-field">
                            <label for="source-field-name" class="form-label">Source field name</label>
                            <input id="source-field-name"
                                   class="form-control"
                                   data-testid="add-mapping-source-field"
                                   placeholder="e.g. Short Description"
                                   @bind="newSourceField" />
                            <span class="helper-text">Enter the source field exactly as it appears in the incoming dump.</span>
                        </div>

                        <div class="form-field">
                            <label for="canonical-name" class="form-label">Canonical name</label>
                            <select id="canonical-name"
                                    class="form-select"
                                    data-testid="add-mapping-canonical-name"
                                    @bind="newCanonicalName">
                                <option value="">-- Select a canonical name --</option>
                                @foreach (var field in canonicalFields.OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@field.Name">@field.Name (@field.DataType)</option>
                                }
                            </select>
                            <span class="helper-text">Choose the normalized display name users should see in history and reporting.</span>
                        </div>

                        <div class="form-field checkbox-field">
                            <label class="checkbox-label">
                                <input type="checkbox"
                                       data-testid="add-mapping-is-required"
                                       @bind="newIsRequired"
                                       disabled="@SelectedCanonicalFieldIsSystemRequired" />
                                <span>Required</span>
                            </label>
                            <span class="helper-text">
                                @(SelectedCanonicalFieldIsSystemRequired
                                    ? "This canonical field is system-required and is always mandatory."
                                    : "Use this when imports should fail if the source field is missing.")
                            </span>
                        </div>
                    </div>

                    @if (SelectedCanonicalField is not null)
                    {
                        <div class="alert alert-info">
                            <strong>Datatype:</strong> @SelectedCanonicalField.DataType
                            @if (SelectedCanonicalField.IsSystemRequired)
                            {
                                <span> · This field is locked by the ticket-key system.</span>
                            }
                        </div>
                    }

                    <div class="button-row">
                        <button class="btn btn-primary" data-testid="add-mapping-submit" @onclick="AddMappingAsync">Add Mapping</button>
                    </div>
                </section>

                <section class="card-surface stack-sm">
                    <h2 class="section-title">Retention controls</h2>
                    <p class="section-subtitle">
                        Export the source archive before hard delete when you need a recoverable copy of mappings and snapshots.
                    </p>
                    @if (confirmHardDelete)
                    {
                        <div class="stack-sm">
                            <div class="alert alert-danger">
                                This will permanently remove the source, all mappings, every snapshot, and all recorded field history.
                            </div>
                            <div class="button-row wrap gap-sm">
                                <button class="btn btn-danger" @onclick="ConfirmHardDeleteAsync">Delete all source data</button>
                                <button class="btn btn-secondary" @onclick="CancelHardDelete">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="button-row wrap gap-sm">
                            <a class="btn btn-secondary" href="/api/export/itsm-sources/@source.Name">Export full archive</a>
                            <button class="btn btn-danger" @onclick="RequestHardDelete">Hard delete source</button>
                        </div>
                    }
                    <a class="btn btn-secondary" href="/canonical-fields">Manage canonical fields</a>
                </section>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public string SourceName { get; set; } = string.Empty;

    private ItsmSource? source;
    private string itsmSource = string.Empty;
    private List<ItsmFieldMapping> mappings = [];
    private List<CanonicalFieldDefinition> canonicalFields = [];
    private string newSourceField = string.Empty;
    private string newCanonicalName = string.Empty;
    private bool newIsRequired;
    private string? addMappingError;
    private string? pageMessage;
    private bool pageMessageIsError;
    private bool confirmHardDelete;

    private CanonicalFieldDefinition? SelectedCanonicalField
        => canonicalFields.FirstOrDefault(f => string.Equals(f.Name, newCanonicalName, StringComparison.OrdinalIgnoreCase));

    private bool SelectedCanonicalFieldIsSystemRequired => SelectedCanonicalField?.IsSystemRequired ?? false;

    private string MappingCountLabel => mappings.Count switch
    {
        0 => "No mappings yet",
        1 => "1 mapping",
        _ => $"{mappings.Count} mappings"
    };

    private string RequiredCountLabel => mappings.Count(m => m.IsRequired) switch
    {
        0 => "No required fields",
        1 => "1 required field",
        var count => $"{count} required fields"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        pageMessage = null;
        pageMessageIsError = false;
        confirmHardDelete = false;
        itsmSource = SourceName;
        source = await ItsmSourceService.GetSourceByNameAsync(SourceName);
        canonicalFields = (await CanonicalFieldService.GetAllAsync()).ToList();

        if (source is not null)
        {
            itsmSource = source.Name;
            var definition = await ItsmSourceService.GetSourceDefinitionAsync(SourceName);
            mappings = definition.Mappings.ToList();
        }
        else
        {
            mappings = [];
        }

        if (SelectedCanonicalFieldIsSystemRequired)
            newIsRequired = true;
    }

    private CanonicalFieldDefinition? GetCanonicalField(string canonicalName)
        => canonicalFields.FirstOrDefault(f => string.Equals(f.Name, canonicalName, StringComparison.OrdinalIgnoreCase));

    private async Task AddMappingAsync()
    {
        addMappingError = null;
        pageMessage = null;
        pageMessageIsError = false;

        if (string.IsNullOrWhiteSpace(newSourceField))
        {
            addMappingError = "Source field name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newCanonicalName))
        {
            addMappingError = "Canonical name is required.";
            return;
        }

        try
        {
            bool effectiveRequired = newIsRequired || SelectedCanonicalFieldIsSystemRequired;
            await ItsmSourceService.UpsertMappingAsync(
                SourceName,
                newSourceField.Trim(),
                newCanonicalName.Trim(),
                effectiveRequired);

            newSourceField = string.Empty;
            newCanonicalName = string.Empty;
            newIsRequired = false;

            await LoadAsync();
            pageMessage = "Field mapping added.";
        }
        catch (Exception ex)
        {
            addMappingError = $"Failed to add mapping: {ex.Message}";
        }
    }

    private async Task DeleteMappingAsync(string sourceFieldName)
    {
        pageMessage = null;
        pageMessageIsError = false;

        try
        {
            await ItsmSourceService.DeleteMappingAsync(SourceName, sourceFieldName);
            await LoadAsync();
            pageMessage = $"Deleted mapping for source field '{sourceFieldName}'.";
        }
        catch (Exception ex)
        {
            pageMessage = ex.Message;
            pageMessageIsError = true;
        }
    }

    private void RequestHardDelete()
    {
        confirmHardDelete = true;
        pageMessage = null;
        pageMessageIsError = false;
    }

    private void CancelHardDelete()
    {
        confirmHardDelete = false;
    }

    private async Task ConfirmHardDeleteAsync()
    {
        if (source is null)
            return;

        try
        {
            await ArchiveService.DeleteSourceAsync(source.Name);
            Navigation.NavigateTo("/itsm-sources", forceLoad: true);
        }
        catch (Exception ex)
        {
            pageMessage = ex.Message;
            pageMessageIsError = true;
            confirmHardDelete = false;
        }
    }
}
