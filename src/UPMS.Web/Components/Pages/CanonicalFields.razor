@page "/canonical-fields"
@rendermode InteractiveServer

@using UPMS.Data

@inject ICanonicalFieldService CanonicalFieldService

<PageTitle>Canonical Fields - UPMS</PageTitle>

<div class="page-shell stack-xl">
    <section class="page-header card-surface page-header-accent">
        <div class="page-header-body stack-md">
            <div class="stack-sm">
                <div class="eyebrow">Configuration</div>
                <h1>Canonical Fields</h1>
                <p>
                    Manage the registered canonical field names used across mappings, ticket reconstruction,
                    snapshots, and reporting. <code>Company</code> and <code>Number</code> are locked because
                    the ticket key system depends on them.
                </p>
            </div>

            <div class="stat-grid compact-stats">
                <article class="stat-card">
                    <span class="stat-label">Registered fields</span>
                    <strong>@definitions.Count</strong>
                    <span class="stat-caption">Available for ITSM source mapping and validation.</span>
                </article>
                <article class="stat-card">
                    <span class="stat-label">System required</span>
                    <strong>@definitions.Count(d => d.IsSystemRequired)</strong>
                    <span class="stat-caption">Locked by the ticket-key rules and cannot be removed.</span>
                </article>
            </div>
        </div>

        <div class="page-header-actions">
            <a class="btn btn-primary" href="#canonical-field-form">Add field</a>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@(messageIsError ? "alert alert-danger" : "alert alert-success")" role="alert">
            @message
        </div>
    }

    <div class="content-grid content-grid-sidebar-right">
        <section class="card-surface stack-md">
            <div class="section-heading">
                <div>
                    <h2 class="section-title">Registered canonical names</h2>
                    <p class="section-subtitle">These are the normalized names presented in mappings, history, and reports.</p>
                </div>
            </div>

            @if (definitions.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">🏷️</div>
                    <div class="stack-xs">
                        <h3>No canonical fields registered</h3>
                        <p>Add a canonical field to start standardizing imported source columns.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="data-table table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Data type</th>
                                <th>Locked</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var definition in definitions.OrderBy(d => d.Name, StringComparer.OrdinalIgnoreCase))
                            {
                                <tr data-testid="canonical-field-row-@definition.Name">
                                    <td>
                                        <div class="stack-xs">
                                            <span>@definition.Name</span>
                                            @if (definition.IsSystemRequired)
                                            {
                                                <span class="table-meta">Required for ticket identity and history reconstruction.</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-muted">@definition.DataType</span>
                                    </td>
                                    <td>
                                        @if (definition.IsSystemRequired)
                                        {
                                            <span class="badge badge-success">System required</span>
                                        }
                                        else
                                        {
                                            <span class="table-meta">No</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="button-row wrap gap-sm">
                                            <button class="btn btn-secondary btn-sm" @onclick="() => BeginEdit(definition)">Edit</button>
                                            @if (!definition.IsSystemRequired)
                                            {
                                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(definition.Name)">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="stack-md">
            <section class="card-surface stack-md" id="canonical-field-form">
                <div class="section-heading">
                    <div>
                        <h2 class="section-title">@(isEditMode ? "Edit canonical field" : "Add canonical field")</h2>
                        <p class="section-subtitle">Choose the display name and datatype used to validate historical values.</p>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-field">
                        <label for="canonical-field-name" class="form-label">Canonical name</label>
                        <input id="canonical-field-name"
                               class="form-control"
                               placeholder="e.g. Resolution Category"
                               @bind="editingName"
                               readonly="@isEditMode" />
                        <span class="helper-text">
                            @(isEditMode
                                ? "Names are fixed during edit mode. To rename a field, add the new field and remap sources."
                                : "Use the normalized display name you want shown across the application.")
                        </span>
                    </div>

                    <div class="form-field">
                        <label for="canonical-field-data-type" class="form-label">Data type</label>
                        <select id="canonical-field-data-type" class="form-select" @bind="editingDataType">
                            @foreach (var dataType in dataTypes)
                            {
                                <option value="@dataType">@dataType</option>
                            }
                        </select>
                        <span class="helper-text">Historical values for this canonical field are validated against this datatype.</span>
                    </div>
                </div>

                <div class="button-row">
                    <button class="btn btn-primary" @onclick="SaveAsync">@(isEditMode ? "Update field" : "Add field")</button>
                    @if (isEditMode)
                    {
                        <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                    }
                </div>
            </section>

            <section class="card-surface stack-sm">
                <h2 class="section-title">Datatype guidance</h2>
                <ul class="token-list compact-token-list">
                    <li><code>Text</code> for labels, descriptions, owners, and free text.</li>
                    <li><code>DateTime</code> for opened, updated, resolved, or closed timestamps.</li>
                    <li><code>Boolean</code> for true/false fields like active flags.</li>
                    <li><code>Integer</code> or <code>Decimal</code> for counts, durations, or numeric measures.</li>
                </ul>
            </section>
        </aside>
    </div>
</div>

@code {
    private readonly IReadOnlyList<CanonicalFieldDataType> dataTypes = Enum.GetValues<CanonicalFieldDataType>();

    private List<CanonicalFieldDefinition> definitions = [];
    private string editingName = string.Empty;
    private CanonicalFieldDataType editingDataType = CanonicalFieldDataType.Text;
    private string? editingOriginalName;
    private string? message;
    private bool messageIsError;

    private bool isEditMode => !string.IsNullOrWhiteSpace(editingOriginalName);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        definitions = (await CanonicalFieldService.GetAllAsync()).ToList();
    }

    private void BeginEdit(CanonicalFieldDefinition definition)
    {
        editingOriginalName = definition.Name;
        editingName = definition.Name;
        editingDataType = definition.DataType;
        message = null;
        messageIsError = false;
    }

    private void CancelEdit()
    {
        ResetEditor();
        message = null;
        messageIsError = false;
    }

    private void ResetEditor()
    {
        editingOriginalName = null;
        editingName = string.Empty;
        editingDataType = CanonicalFieldDataType.Text;
    }

    private async Task SaveAsync()
    {
        message = null;
        messageIsError = false;

        if (string.IsNullOrWhiteSpace(editingName))
        {
            message = "Canonical name is required.";
            messageIsError = true;
            return;
        }

        try
        {
            await CanonicalFieldService.UpsertAsync(editingName.Trim(), editingDataType);
            string savedName = editingName.Trim();
            bool wasEdit = isEditMode;
            await LoadAsync();
            ResetEditor();
            message = wasEdit
                ? $"Updated canonical field '{savedName}'."
                : $"Added canonical field '{savedName}'.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageIsError = true;
        }
    }

    private async Task DeleteAsync(string name)
    {
        message = null;
        messageIsError = false;

        try
        {
            await CanonicalFieldService.DeleteAsync(name);
            await LoadAsync();
            message = $"Deleted canonical field '{name}'.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageIsError = true;
        }
    }
}
