@page "/report-templates"
@rendermode InteractiveServer

@using UPMS.Web.Templates

@inject IReportTemplateStore TemplateStore

<PageTitle>Report Templates - UPMS</PageTitle>

<h1>Report Templates</h1>
<p>Upload tokenised templates that the reporting system can fill with live ticket data. Supported types: HTML/EML/TXT/CSV/XML and basic OOXML package files (.docx, .xlsx, .pptx).</p>

<div class="mb-4">
    <h2>Upload Template</h2>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p role="alert">@message</p>
    }

    <div>
        <label for="template-display-name">Display Name</label>
        <input id="template-display-name" @bind="displayName" />
    </div>

    <div>
        <label for="template-kind">Template Kind</label>
        <select id="template-kind" @bind="selectedKind">
            @foreach (var kind in kinds)
            {
                <option value="@kind">@kind</option>
            }
        </select>
    </div>

    <div>
        <label for="template-description">Description</label>
        <textarea id="template-description" rows="3" @bind="description"></textarea>
    </div>

    <div>
        <label for="template-subject">Email Subject Template</label>
        <input id="template-subject" @bind="subjectTemplate" placeholder="Optional. Used for HTML email templates when exporting as .eml" />
    </div>

    <div>
        <label for="template-file">Template File</label>
        <InputFile id="template-file" OnChange="OnFileSelected" accept=".html,.htm,.txt,.csv,.xml,.eml,.docx,.xlsx,.pptx" />
    </div>

    <button @onclick="UploadAsync">Upload Template</button>
</div>

<div class="mb-4">
    <h2>Available Tokens</h2>
    <p>These tokens are currently generated by the prototype template plugin:</p>
    <ul>
        <li><code>{{company}}</code>, <code>{{itsm_source}}</code>, <code>{{as_of_date}}</code>, <code>{{generated_at_utc}}</code>, <code>{{requested_by}}</code></li>
        <li><code>{{ticket_count}}</code>, <code>{{ticket_key}}</code>, <code>{{ticket_number}}</code>, <code>{{ticket_status}}</code>, <code>{{ticket_priority}}</code></li>
        <li><code>{{tickets_html_table}}</code>, <code>{{ticket_rows_html}}</code>, <code>{{tickets_text_list}}</code>, <code>{{tickets_csv_document}}</code></li>
        <li><code>{{month_end_chart_svg}}</code>, <code>{{month_end_table_html}}</code>, <code>{{month_end_backlog_current}}</code>, <code>{{month_end_opened_current}}</code>, <code>{{month_end_resolved_current}}</code></li>
    </ul>
    <p>For .docx/.xlsx/.pptx templates, keep tokens as plain contiguous text such as <code>{{company}}</code>. The current fill engine performs direct XML text replacement and works best when a token is not split across multiple formatting runs.</p>
</div>

<div>
    <h2>Uploaded Templates</h2>
    @if (templates.Count == 0)
    {
        <p>No templates uploaded yet.</p>
    }
    else
    {
        <table data-testid="report-template-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Kind</th>
                    <th>File Type</th>
                    <th>Description</th>
                    <th>Uploaded</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var template in templates)
                {
                    <tr>
                        <td>@template.DisplayName</td>
                        <td>@template.Kind</td>
                        <td>@template.Extension</td>
                        <td>@template.Description</td>
                        <td>@template.UploadedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private readonly IReadOnlyList<ReportTemplateKind> kinds = Enum.GetValues<ReportTemplateKind>();
    private List<ReportTemplateMetadata> templates = [];
    private string displayName = string.Empty;
    private string description = string.Empty;
    private string subjectTemplate = string.Empty;
    private ReportTemplateKind selectedKind = ReportTemplateKind.Document;
    private IBrowserFile? selectedFile;
    private string? message;

    protected override void OnInitialized()
    {
        ReloadTemplates();
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        message = null;
    }

    private async Task UploadAsync()
    {
        message = null;

        if (string.IsNullOrWhiteSpace(displayName))
        {
            message = "Display name is required.";
            return;
        }

        if (selectedFile is null)
        {
            message = "Please choose a template file to upload.";
            return;
        }

        try
        {
            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            await TemplateStore.SaveAsync(new ReportTemplateUploadRequest
            {
                DisplayName = displayName.Trim(),
                Kind = selectedKind,
                Description = string.IsNullOrWhiteSpace(description) ? null : description.Trim(),
                SubjectTemplate = string.IsNullOrWhiteSpace(subjectTemplate) ? null : subjectTemplate.Trim(),
                OriginalFileName = selectedFile.Name,
                UploadedBy = "web-user"
            }, stream);

            displayName = string.Empty;
            description = string.Empty;
            subjectTemplate = string.Empty;
            selectedFile = null;
            message = "Template uploaded successfully.";
            ReloadTemplates();
        }
        catch (Exception ex)
        {
            message = $"Failed to upload template: {ex.Message}";
        }
    }

    private void ReloadTemplates()
    {
        templates = TemplateStore.GetAllTemplates().ToList();
    }
}
