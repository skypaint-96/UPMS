@page "/snapshots/{SnapshotId}"

<PageTitle>Snapshot @SnapshotId - UPMS</PageTitle>

<h1>Snapshot @SnapshotId</h1>

<p data-testid="snapshot-itsm-source">ITSM Source: @itsmSource</p>
<p data-testid="snapshot-date">Snapshot Date: @snapshotDate</p>

<a href="/snapshots">Back to Snapshots</a>

<table class="table table-striped table-hover" data-testid="snapshot-ticket-table">
    <thead>
        <tr>
            <th>Ticket Key</th>
            <th>Company</th>
            <th>ITSM Source</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (tickets.Count == 0)
        {
            <tr data-testid="snapshot-ticket-table-empty">
                <td colspan="4">No tickets found in this snapshot.</td>
            </tr>
        }
        else
        {
            @foreach (Ticket ticket in tickets)
            {
                ticket.Fields.TryGetValue("ticket_number", out var ticketNumber);
                string? status = null;
                if (!ticket.Fields.TryGetValue("status", out status))
                {
                    ticket.Fields.TryGetValue("Status", out status);
                }
                <tr>
                    <td>
                        <a href="/tickets/@Uri.EscapeDataString(ticket.CompanyName)/@Uri.EscapeDataString(ticket.ItsmSource)/@Uri.EscapeDataString(ticket.TicketKey)?asOf=@Uri.EscapeDataString(ticket.SnapshotDate.ToString(\"yyyy-MM-ddTHH:mm\"))">@(string.IsNullOrWhiteSpace(ticketNumber) ? ticket.TicketKey : ticketNumber)</a>
                        @if (!string.IsNullOrWhiteSpace(ticketNumber))
                        {
                            <div class="text-muted small">@ticket.TicketKey</div>
                        }
                    </td>
                    <td>@ticket.CompanyName</td>
                    <td>@ticket.ItsmSource</td>
                    <td>@(string.IsNullOrWhiteSpace(status) ? "—" : status)</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter]
    public string SnapshotId { get; set; } = string.Empty;

    [Inject]
    private TicketDataServiceInstance DataService { get; set; } = default!;

    private List<Ticket> tickets = [];
    private string itsmSource = string.Empty;
    private string snapshotDate = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Guid.TryParse(SnapshotId, out Guid parsedId))
            {
                IEnumerable<Ticket> results = await DataService.GetTicketsBySnapshotAsync(parsedId);
                tickets = results.ToList();

                Ticket? first = tickets.FirstOrDefault();
                if (first is not null)
                {
                    itsmSource = first.ItsmSource;
                    snapshotDate = first.SnapshotDate.ToString("yyyy-MM-dd HH:mm:ss");
                }
            }
        }
        catch
        {
            tickets = [];
        }
    }
}
