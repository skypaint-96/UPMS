@page "/tickets/{Company}/{ItsmSource}/{TicketKey}"
@page "/tickets/{Company}/{TicketKey}"
@rendermode InteractiveServer

@using System.Globalization

<PageTitle>@TicketKey - UPMS</PageTitle>

<h1>@TicketKey</h1>

<p data-testid="ticket-company">Company: @Company</p>
<p data-testid="ticket-itsm-source">ITSM Source: @resolvedItsmSource</p>

<div class="d-flex flex-wrap gap-2 align-items-end" style="margin: 1rem 0">
    <div>
        <label class="form-label" for="as-of">As of</label>
        <input id="as-of"
               class="form-control"
               type="datetime-local"
               data-testid="ticket-as-of-datetime"
               @bind="asOfDateTime"
               @bind:event="oninput"
               @bind:after="OnAsOfLocalChanged" />
    </div>
    <button class="btn btn-primary" data-testid="ticket-load-btn" @onclick="NavigateToAsOf" disabled="@isLoading">Load</button>
    @if (isLoading)
    {
        <span class="ms-2" data-testid="ticket-loading-indicator">Loading...</span>
    }
</div>

@if (!string.IsNullOrWhiteSpace(asOfContextText))
{
    <div class="alert alert-info" role="alert" data-testid="ticket-as-of-context">
        @asOfContextText
    </div>
}

@if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger" role="alert" data-testid="ticket-load-error">
        @loadError
    </div>
}

<a href="/tickets">Back to Tickets</a>

<section data-testid="ticket-fields">
    <h2>Fields</h2>
    @if (fields.Count > 0)
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th style="width: 16rem">Field</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (KeyValuePair<string, string?> field in fields.OrderBy(k => k.Key, StringComparer.OrdinalIgnoreCase))
                {
                    <tr>
                        <td><strong>@field.Key</strong></td>
                        <td>@(field.Value ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No field data available.</p>
    }
</section>

@if (snapshotFieldDeltas.Count > 0)
{
    <section data-testid="ticket-snapshot-deltas">
        <h2>Changes since previous snapshot</h2>
        <p class="text-muted" style="max-width: 80ch">
            These are the fields whose values differ compared to the previous snapshot for this ticket.
        </p>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Field</th>
                    <th>Previous</th>
                    <th>Current</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var delta in snapshotFieldDeltas)
                {
                    <tr>
                        <td><strong>@delta.FieldName</strong></td>
                        <td>@(delta.PreviousValue ?? "—")</td>
                        <td>@(delta.CurrentValue ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

<section data-testid="field-history">
    <h2>Field Change History</h2>
    @if (fieldChanges.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Field</th>
                    <th>Value</th>
                    <th>Observed At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FieldChange change in fieldChanges)
                {
                    <tr>
                        <td>@change.FieldName</td>
                        <td>@(change.FieldValue ?? "—")</td>
                        <td>@change.ObservedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No change history available.</p>
    }
</section>

@code {
    [Parameter]
    public string Company { get; set; } = string.Empty;

    [Parameter]
    public string? ItsmSource { get; set; }

    [Parameter]
    public string TicketKey { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "asOf")]
    public string? AsOfQuery { get; set; }

    [Inject]
    private TicketDataServiceInstance DataService { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private string resolvedItsmSource = string.Empty;
    private string decodedCompany = string.Empty;
    private string decodedTicketKey = string.Empty;

    private Dictionary<string, string?> fields = [];
    private List<FieldChange> fieldChanges = [];
    private string? loadError;
    private string? asOfContextText;
    private bool isLoading;

    private DateTime asOfDateTime = DateTime.UtcNow;
    private string asOfLocal = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);

    private record FieldDelta(string FieldName, string? PreviousValue, string? CurrentValue);
    private List<FieldDelta> snapshotFieldDeltas = [];

    protected override async Task OnParametersSetAsync()
    {
        await LoadTicketAsync();
    }

    private async Task LoadTicketAsync()
    {
        isLoading = true;
        loadError = null;
        asOfContextText = null;
        fields = [];
        fieldChanges = [];
        snapshotFieldDeltas.Clear();

        try
        {
            decodedCompany = Uri.UnescapeDataString(Company);
            decodedTicketKey = Uri.UnescapeDataString(TicketKey);
            string? decodedItsmSource = ItsmSource is not null ? Uri.UnescapeDataString(ItsmSource) : null;

            // Resolve "as of" (UTC) from query param (if supplied).
            if (TryParseAsOfUtc(AsOfQuery, out var parsedUtc, out var normalizedLocal))
            {
                asOfDateTime = parsedUtc;
                asOfLocal = normalizedLocal;
            }
            else
            {
                // No (valid) query provided: keep the last valid value, and ensure
                // the input stays in a canonical format.
                if (asOfDateTime == default)
                    asOfDateTime = DateTime.UtcNow;

                asOfDateTime = DateTime.SpecifyKind(asOfDateTime, DateTimeKind.Utc);
                asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
            }

            // If no ITSM source provided in route, try to infer.
            if (string.IsNullOrWhiteSpace(decodedItsmSource))
            {
                // 1) Try parsing it from the generated ticket key.
                if (TicketKeyFactory.TryParse(decodedTicketKey, out var parsedSrc, out _, out _))
                {
                    decodedItsmSource = parsedSrc;
                }
                else
                {
                    // 2) Fallback: pick the first known snapshot source.
                    IEnumerable<Snapshot> snapshots = await DataService.GetSnapshotsAsync();
                    decodedItsmSource = snapshots.FirstOrDefault()?.ItsmSource ?? string.Empty;
                }
            }

            resolvedItsmSource = decodedItsmSource ?? string.Empty;

            if (string.IsNullOrWhiteSpace(resolvedItsmSource))
            {
                loadError = "Unable to determine ITSM source for this ticket.";
                return;
            }

            // Load ticket fields as-of the requested timestamp.
            var tickets = await DataService.GetTicketsAsync(resolvedItsmSource, decodedCompany, asOfDateTime);
            var ticket = tickets.FirstOrDefault(t => t.TicketKey == decodedTicketKey);

            if (ticket is null)
            {
                loadError = "Ticket not found for the selected 'as of' date.";
                return;
            }

            fields = new Dictionary<string, string?>(ticket.Fields, StringComparer.Ordinal);

            // Compute deltas versus the previous snapshot for this ticket (based on the effective snapshot date).
            if (ticket.SnapshotDate != default && ticket.SnapshotDate != DateTime.MinValue)
            {
                var prevTickets = await DataService.GetTicketsAsync(resolvedItsmSource, decodedCompany, ticket.SnapshotDate.AddTicks(-1));
                var prev = prevTickets.FirstOrDefault(t => t.TicketKey == decodedTicketKey);

                if (prev is not null)
                {
                    snapshotFieldDeltas = BuildDeltas(prev.Fields, ticket.Fields);
                }
            }

            asOfContextText = BuildAsOfContextText(asOfDateTime, ticket.SnapshotDate);

            // Load full field history for this ticket.
            fieldChanges = (await DataService.GetTicketHistoryAsync(decodedCompany, decodedTicketKey)).ToList();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string BuildAsOfContextText(DateTime asOfUtc, DateTime effectiveSnapshotDate)
    {
        var asOfText = asOfUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

        if (effectiveSnapshotDate == default || effectiveSnapshotDate == DateTime.MinValue)
            return $"Viewing ticket as of {asOfText} (no snapshot context available).";

        var snapText = effectiveSnapshotDate.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

        if (effectiveSnapshotDate == asOfUtc)
            return $"Viewing ticket as of snapshot {snapText}.";

        return $"Viewing ticket as of {asOfText} (effective snapshot {snapText}).";
    }

    private void OnAsOfLocalChanged()
    {
        var value = asOfLocal;

        // If the input is invalid, keep the last valid value instead of switching to "now".
        if (TryParseAsOfUtc(value, out var parsedUtc, out var normalizedLocal))
        {
            asOfDateTime = parsedUtc;
            asOfLocal = normalizedLocal;
            return;
        }

        if (string.IsNullOrWhiteSpace(asOfLocal))
        {
            asOfDateTime = DateTime.UtcNow;
            asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
        }
    }

    private void NavigateToAsOf()
    {
        // Parse and normalize before navigating.
        if (TryParseAsOfUtc(asOfLocal, out var parsedUtc, out var normalizedLocal))
        {
            asOfDateTime = parsedUtc;
            asOfLocal = normalizedLocal;
        }
        else
        {
            asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
        }

        var company = Uri.EscapeDataString(decodedCompany.Length > 0 ? decodedCompany : Uri.UnescapeDataString(Company));
        var ticketKey = Uri.EscapeDataString(decodedTicketKey.Length > 0 ? decodedTicketKey : Uri.UnescapeDataString(TicketKey));
        var itsmResolved = resolvedItsmSource;

        var query = $"asOf={Uri.EscapeDataString(asOfLocal)}";

        // Prefer the full route when we have an ITSM source, but fall back to the shorter route
        // if we can't resolve it yet.
        if (!string.IsNullOrWhiteSpace(itsmResolved))
        {
            var itsm = Uri.EscapeDataString(itsmResolved);
            Navigation.NavigateTo($"/tickets/{company}/{itsm}/{ticketKey}?{query}");
            return;
        }

        Navigation.NavigateTo($"/tickets/{company}/{ticketKey}?{query}");
    }

    private static readonly string[] AsOfInputFormats =
    [
        "yyyy-MM-ddTHH:mm",
        "yyyy-MM-ddTHH:mm:ss",
        "yyyy-MM-ddTHH:mm:ss.fff",
        "yyyy-MM-ddTHH:mm:ss.FFFFFFF"
    ];

    private static bool TryParseAsOfUtc(string? input, out DateTime asOfUtc, out string normalizedLocal)
    {
        asOfUtc = default;
        normalizedLocal = string.Empty;

        if (string.IsNullOrWhiteSpace(input))
            return false;

        if (DateTime.TryParseExact(
            input,
            AsOfInputFormats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out var dt))
        {
            asOfUtc = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
            normalizedLocal = asOfUtc.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
            return true;
        }

        if (DateTime.TryParse(
            input,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out dt))
        {
            asOfUtc = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
            normalizedLocal = asOfUtc.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
            return true;
        }

        return false;
    }

    private static List<FieldDelta> BuildDeltas(IDictionary<string, string?> previous, IDictionary<string, string?> current)
    {
        var keys = new HashSet<string>(previous.Keys, StringComparer.OrdinalIgnoreCase);
        keys.UnionWith(current.Keys);

        var deltas = new List<FieldDelta>();
        foreach (var key in keys)
        {
            previous.TryGetValue(key, out var prevVal);
            current.TryGetValue(key, out var curVal);

            if (!string.Equals(prevVal ?? string.Empty, curVal ?? string.Empty, StringComparison.Ordinal))
            {
                deltas.Add(new FieldDelta(key, prevVal, curVal));
            }
        }

        return deltas.OrderBy(d => d.FieldName, StringComparer.OrdinalIgnoreCase).ToList();
    }
}
