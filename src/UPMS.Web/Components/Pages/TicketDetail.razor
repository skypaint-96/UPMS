@page "/tickets/{Company}/{ItsmSource}/{TicketKey}"
@page "/tickets/{Company}/{TicketKey}"

@using System.Globalization

<PageTitle>@TicketKey - UPMS</PageTitle>

<h1>@TicketKey</h1>

<p data-testid="ticket-company">Company: @Company</p>
<p data-testid="ticket-itsm-source">ITSM Source: @resolvedItsmSource</p>

<div class="d-flex flex-wrap gap-2 align-items-end mb-3" data-testid="ticket-asof-panel">
    <div>
        <label class="form-label" for="ticket-as-of">As of (UTC)</label>
        <input id="ticket-as-of" class="form-control" type="datetime-local" value="@asOfLocal" @onchange="OnAsOfLocalChanged" />
    </div>
    <button class="btn btn-primary" @onclick="ApplyAsOf">Apply</button>
    <button class="btn btn-outline-secondary" @onclick="SetAsOfNow">Now</button>
</div>

@if (!string.IsNullOrWhiteSpace(snapshotContextText))
{
    <div class="alert alert-info" role="alert" data-testid="ticket-snapshot-context">
        @snapshotContextText
    </div>
}

@if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger" role="alert" data-testid="ticket-load-error">
        @loadError
    </div>
}

<a href="/tickets">Back to Tickets</a>

<section data-testid="ticket-fields">
    <h2>Fields</h2>
    @if (fields.Count > 0)
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th style="width: 16rem">Field</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (KeyValuePair<string, string?> field in fields.OrderBy(k => k.Key, StringComparer.OrdinalIgnoreCase))
                {
                    <tr>
                        <td><strong>@field.Key</strong></td>
                        <td>@(field.Value ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No field data available.</p>
    }
</section>

@if (snapshotFieldDeltas.Count > 0)
{
    <section data-testid="ticket-snapshot-deltas">
        <h2>Changes in this Snapshot</h2>
        <p class="text-muted" style="max-width: 80ch">
            These are the fields whose values differ compared to the previous snapshot for this ticket.
        </p>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Field</th>
                    <th>Previous</th>
                    <th>Current</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var delta in snapshotFieldDeltas)
                {
                    <tr>
                        <td><strong>@delta.FieldName</strong></td>
                        <td>@(delta.PreviousValue ?? "—")</td>
                        <td>@(delta.CurrentValue ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

<section data-testid="field-history">
    <h2>Field Change History</h2>
    @if (fieldChanges.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Field</th>
                    <th>Value</th>
                    <th>Observed At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FieldChange change in fieldChanges)
                {
                    <tr>
                        <td>@change.FieldName</td>
                        <td>@(change.FieldValue ?? "—")</td>
                        <td>@change.ObservedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No change history available.</p>
    }
</section>

@code {
    [Parameter]
    public string Company { get; set; } = string.Empty;

    [Parameter]
    public string? ItsmSource { get; set; }

    [Parameter]
    public string TicketKey { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "asOf")]
    public string? AsOfQuery { get; set; }

    [Inject]
    private TicketDataServiceInstance DataService { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private string resolvedItsmSource = string.Empty;
    private Dictionary<string, string?> fields = [];
    private List<FieldChange> fieldChanges = [];
    private string? loadError;
    private string? snapshotContextText;
    private DateTime? asOf;
    private string asOfLocal = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm");

    private record FieldDelta(string FieldName, string? PreviousValue, string? CurrentValue);
    private List<FieldDelta> snapshotFieldDeltas = [];

    protected override async Task OnParametersSetAsync()
    {
        loadError = null;
        snapshotContextText = null;
        snapshotFieldDeltas.Clear();

        try
        {
            string decodedCompany = Uri.UnescapeDataString(Company);
            string decodedTicketKey = Uri.UnescapeDataString(TicketKey);
            string? decodedItsmSource = ItsmSource is not null ? Uri.UnescapeDataString(ItsmSource) : null;

            // As-of context (optional): ?asOf=yyyy-MM-ddTHH:mm
            if (!TryParseDateTimeLocal(AsOfQuery, out var parsedAsOf))
            {
                parsedAsOf = DateTime.UtcNow;
            }

            asOf = parsedAsOf;
            asOfLocal = asOf.Value.ToString("yyyy-MM-ddTHH:mm");
            if (!string.IsNullOrWhiteSpace(AsOfQuery))
            {
                snapshotContextText = $"Viewing ticket as of {asOf:yyyy-MM-dd HH:mm} (UTC).";
            }

            Ticket? ticket = null;

            // If no ITSM source provided in route (or snapshot didn't resolve), try to infer.
            if (string.IsNullOrWhiteSpace(decodedItsmSource))
            {
                // 1) Try parsing it from the generated ticket key.
                if (TicketKeyFactory.TryParse(decodedTicketKey, out var parsedSrc, out _, out _))
                {
                    decodedItsmSource = parsedSrc;
                }
                else
                {
                    // 2) Fallback: pick the first known snapshot source.
                    IEnumerable<Snapshot> snapshots = await DataService.GetSnapshotsAsync();
                    decodedItsmSource = snapshots.FirstOrDefault()?.ItsmSource ?? string.Empty;
                }
            }

            resolvedItsmSource = decodedItsmSource;

            // Load the ticket as-of the selected time.
            if (ticket is null && !string.IsNullOrWhiteSpace(decodedItsmSource))
            {
                var tickets = await DataService.GetTicketsAsync(decodedItsmSource, decodedCompany, asOf.Value);
                ticket = tickets.FirstOrDefault(t => t.TicketKey == decodedTicketKey);
            }

            if (ticket is null)
            {
                loadError = "Ticket not found for the selected context.";
                return;
            }

            fields = new Dictionary<string, string?>(ticket.Fields, StringComparer.Ordinal);

            // Compute deltas versus the immediately previous snapshot state (if any).
            if (asOf.HasValue)
            {
                var prevTickets = await DataService.GetTicketsAsync(resolvedItsmSource, decodedCompany, asOf.Value.AddTicks(-1));
                var prev = prevTickets.FirstOrDefault(t => t.TicketKey == decodedTicketKey);

                if (prev is not null)
                {
                    snapshotFieldDeltas = BuildDeltas(prev.Fields, ticket.Fields);
                }
            }

            // Load full field history for this ticket.
            fieldChanges = (await DataService.GetTicketHistoryAsync(decodedCompany, decodedTicketKey)).ToList();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private void OnAsOfLocalChanged(ChangeEventArgs e)
    {
        var value = e?.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(value) && TryParseDateTimeLocal(value, out var dt))
        {
            asOfLocal = dt.ToString("yyyy-MM-ddTHH:mm");
            return;
        }

        // Revert to last known-good.
        asOfLocal = (asOf ?? DateTime.UtcNow).ToString("yyyy-MM-ddTHH:mm");
    }

    private void ApplyAsOf()
    {
        var baseUri = NavigationManager.Uri.Split('?', '#')[0];
        NavigationManager.NavigateTo($"{baseUri}?asOf={Uri.EscapeDataString(asOfLocal)}");
    }

    private void SetAsOfNow()
    {
        asOfLocal = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm");
        ApplyAsOf();
    }

    private static readonly string[] DateTimeLocalFormats =
    [
        "yyyy-MM-ddTHH:mm",
        "yyyy-MM-ddTHH:mm:ss",
        "yyyy-MM-ddTHH:mm:ss.fff",
        "yyyy-MM-ddTHH:mm:ss.FFFFFFF"
    ];

    private static bool TryParseDateTimeLocal(string? input, out DateTime utc)
    {
        utc = default;
        if (string.IsNullOrWhiteSpace(input))
            return false;

        if (DateTime.TryParseExact(input, DateTimeLocalFormats, CultureInfo.InvariantCulture,
            DateTimeStyles.AllowWhiteSpaces, out var parsed))
        {
            utc = DateTime.SpecifyKind(parsed, DateTimeKind.Utc);
            return true;
        }

        if (DateTime.TryParse(input, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out parsed))
        {
            utc = DateTime.SpecifyKind(parsed, DateTimeKind.Utc);
            return true;
        }

        return false;
    }

    private static List<FieldDelta> BuildDeltas(IDictionary<string, string?> previous, IDictionary<string, string?> current)
    {
        var keys = new HashSet<string>(previous.Keys, StringComparer.OrdinalIgnoreCase);
        keys.UnionWith(current.Keys);

        var deltas = new List<FieldDelta>();
        foreach (var key in keys)
        {
            previous.TryGetValue(key, out var prevVal);
            current.TryGetValue(key, out var curVal);

            if (!string.Equals(prevVal ?? string.Empty, curVal ?? string.Empty, StringComparison.Ordinal))
            {
                deltas.Add(new FieldDelta(key, prevVal, curVal));
            }
        }

        return deltas.OrderBy(d => d.FieldName, StringComparer.OrdinalIgnoreCase).ToList();
    }
}
