@page "/itsm-sources"
@rendermode InteractiveServer

@using UPMS.Data
@using UPMS.Web.Services

@inject IItsmSourceService ItsmSourceService
@inject IUpmsArchiveService ArchiveService

<PageTitle>ITSM Sources - UPMS</PageTitle>

<div class="page-shell stack-xl">
    <section class="page-header card-surface page-header-accent">
        <div class="page-header-body stack-md">
            <div class="stack-sm">
                <div class="eyebrow">Configuration</div>
                <h1>ITSM Sources</h1>
                <p>
                    Define the systems that feed ticket snapshots into UPMS. Each source gets a friendly label,
                    a stable slug, its own field mappings, and export/delete controls for full retention management.
                </p>
            </div>

            <div class="stat-grid compact-stats">
                <article class="stat-card">
                    <span class="stat-label">Configured sources</span>
                    <strong>@sources.Count</strong>
                    <span class="stat-caption">Ready for uploads, exports, and reporting.</span>
                </article>
                <article class="stat-card">
                    <span class="stat-label">Next step</span>
                    <strong>@GetNextStepLabel()</strong>
                    <span class="stat-caption">Create or import a source, then review its mappings.</span>
                </article>
            </div>
        </div>

        <div class="page-header-actions">
            <a class="btn btn-primary" href="#add-source-form">Add source</a>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(pageMessage))
    {
        <div class="@(pageMessageIsError ? "alert alert-danger" : "alert alert-success")" role="alert">
            @pageMessage
        </div>
    }

    <div class="content-grid content-grid-sidebar-right">
        <section class="card-surface stack-md">
            <div class="section-heading">
                <div>
                    <h2 class="section-title">Current sources</h2>
                    <p class="section-subtitle">Open a source to manage mappings, export a full archive, or hard-delete all associated data.</p>
                </div>
                <span class="badge badge-info">@SourceSummary</span>
            </div>

            <div data-testid="itsm-sources-list">
                @if (sources.Count == 0)
                {
                    <div class="empty-state" data-testid="no-sources-message">
                        <div class="empty-state-icon">🧩</div>
                        <div class="stack-xs">
                            <h3>No ITSM sources defined yet</h3>
                            <p>
                                Add your first source to start uploading snapshots. A good slug uses lowercase letters,
                                numbers, and hyphens so it stays stable in URLs and automation.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="data-table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Display Label</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var source in sources.OrderBy(s => s.DisplayLabel).ThenBy(s => s.Name))
                                {
                                    <tr data-testid="source-row-@source.Name">
                                        <td>
                                            <div class="stack-xs">
                                                <a class="table-link"
                                                   href="/itsm-sources/@source.Name"
                                                   data-testid="source-link-@source.Name">
                                                    @source.Name
                                                </a>
                                                <span class="table-meta">Stable slug used in uploads, ticket keys, and exports.</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="stack-xs">
                                                <span>@source.DisplayLabel</span>
                                                @if (!string.Equals(source.DisplayLabel, source.Name, StringComparison.Ordinal))
                                                {
                                                    <span class="table-meta">Shown across dashboards and reports.</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (confirmDeleteName == source.Name)
                                            {
                                                <div class="inline-confirm">
                                                    <span>Hard-delete this source and all of its mappings, snapshots, and field history?</span>
                                                    <button class="btn btn-danger btn-sm"
                                                            data-testid="confirm-delete-@source.Name"
                                                            @onclick="() => ConfirmDeleteAsync(source.Name)">
                                                        Yes, delete all data
                                                    </button>
                                                    <button class="btn btn-secondary btn-sm" @onclick="CancelDelete">Cancel</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="button-row wrap gap-sm">
                                                    <a class="btn btn-secondary btn-sm" href="/itsm-sources/@source.Name">Manage mappings</a>
                                                    <a class="btn btn-secondary btn-sm" href="/api/export/itsm-sources/@source.Name">Export archive</a>
                                                    <button class="btn btn-danger btn-sm"
                                                            data-testid="delete-source-@source.Name"
                                                            @onclick="() => RequestDelete(source.Name)">
                                                        Hard delete
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

        <aside class="stack-md">
            <section class="card-surface stack-md" id="add-source-form">
                <div class="section-heading">
                    <div>
                        <h2 class="section-title">Add ITSM source</h2>
                        <p class="section-subtitle">Create the source before configuring field mappings or imports.</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(addError))
                {
                    <div class="alert alert-danger" data-testid="add-source-error" role="alert">@addError</div>
                }

                <div class="form-grid">
                    <div class="form-field">
                        <label for="add-source-name" class="form-label">Name (slug)</label>
                        <input id="add-source-name"
                               class="form-control"
                               data-testid="add-source-name"
                               placeholder="e.g. servicenow-client-a"
                               @bind="newSourceName" />
                        <span class="helper-text">Use lowercase letters, numbers, and hyphens. This becomes part of the URL.</span>
                    </div>

                    <div class="form-field">
                        <label for="add-source-label" class="form-label">Display label</label>
                        <input id="add-source-label"
                               class="form-control"
                               data-testid="add-source-label"
                               placeholder="e.g. ServiceNow (Client A)"
                               @bind="newSourceLabel" />
                        <span class="helper-text">This is what users will see in filters, tables, and reports.</span>
                    </div>
                </div>

                <div class="button-row">
                    <button class="btn btn-primary" data-testid="add-source-submit" @onclick="AddSourceAsync">Add Source</button>
                </div>
            </section>

            <section class="card-surface stack-md">
                <div class="section-heading">
                    <div>
                        <h2 class="section-title">Import ITSM source</h2>
                        <p class="section-subtitle">Restore a previously exported source archive, including mappings and snapshots.</p>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-field">
                        <label for="import-source-file" class="form-label">Archive file</label>
                        <InputFile id="import-source-file" class="form-control" OnChange="OnImportFileSelected" accept=".json" />
                        <span class="helper-text">Choose a JSON archive previously exported from UPMS.</span>
                    </div>

                    <div class="form-field checkbox-field">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="replaceExistingOnImport" />
                            <span>Replace existing source with the same name</span>
                        </label>
                        <span class="helper-text">When enabled, the current source, mappings, snapshots, and history are removed before import.</span>
                    </div>
                </div>

                <div class="button-row">
                    <button class="btn btn-primary" @onclick="ImportSourceAsync" disabled="@(selectedImportFile is null)">Import source archive</button>
                </div>
            </section>

            <section class="card-surface stack-sm">
                <h2 class="section-title">Recommended setup</h2>
                <ol class="info-steps">
                    <li>Create or import the source with a stable slug.</li>
                    <li>Open the source and map incoming fields to canonical names.</li>
                    <li>Upload a snapshot to validate mappings and populate history.</li>
                    <li>Export before hard delete when you need a recoverable copy.</li>
                </ol>
                <a class="btn btn-secondary" href="/canonical-fields">Manage canonical fields</a>
            </section>
        </aside>
    </div>
</div>

@code {
    private List<ItsmSource> sources = [];
    private string newSourceName = string.Empty;
    private string newSourceLabel = string.Empty;
    private string? addError;
    private string? confirmDeleteName;
    private string? pageMessage;
    private bool pageMessageIsError;
    private IBrowserFile? selectedImportFile;
    private bool replaceExistingOnImport;

    private string SourceSummary => sources.Count switch
    {
        0 => "No sources yet",
        1 => "1 source configured",
        _ => $"{sources.Count} sources configured"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadSourcesAsync();
    }

    private async Task LoadSourcesAsync()
    {
        var result = await ItsmSourceService.GetAllSourcesAsync();
        sources = result.ToList();
    }

    private async Task AddSourceAsync()
    {
        addError = null;
        pageMessage = null;
        pageMessageIsError = false;

        if (string.IsNullOrWhiteSpace(newSourceName))
        {
            addError = "Name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newSourceLabel))
        {
            addError = "Display label is required.";
            return;
        }

        try
        {
            await ItsmSourceService.CreateSourceAsync(newSourceName.Trim(), newSourceLabel.Trim());
            newSourceName = string.Empty;
            newSourceLabel = string.Empty;
            await LoadSourcesAsync();
            pageMessage = "ITSM source added.";
        }
        catch (Exception ex)
        {
            addError = $"Failed to add source: {ex.Message}";
        }
    }

    private void RequestDelete(string name)
    {
        confirmDeleteName = name;
        pageMessage = null;
        pageMessageIsError = false;
    }

    private void CancelDelete()
    {
        confirmDeleteName = null;
    }

    private async Task ConfirmDeleteAsync(string name)
    {
        confirmDeleteName = null;
        pageMessage = null;
        pageMessageIsError = false;

        try
        {
            await ArchiveService.DeleteSourceAsync(name);
            await LoadSourcesAsync();
            pageMessage = $"Deleted ITSM source '{name}' and all associated mappings, snapshots, and history.";
        }
        catch (Exception ex)
        {
            pageMessage = ex.Message;
            pageMessageIsError = true;
        }
    }

    private void OnImportFileSelected(InputFileChangeEventArgs args)
    {
        selectedImportFile = args.File;
        pageMessage = null;
        pageMessageIsError = false;
    }

    private async Task ImportSourceAsync()
    {
        pageMessage = null;
        pageMessageIsError = false;

        if (selectedImportFile is null)
        {
            pageMessage = "Please choose an archive file to import.";
            pageMessageIsError = true;
            return;
        }

        try
        {
            await using var stream = selectedImportFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            var result = await ArchiveService.ImportSourceAsync(stream, replaceExistingOnImport);
            await LoadSourcesAsync();
            selectedImportFile = null;
            pageMessage = $"Imported source '{result.SourceName}' with {result.MappingCount} mapping(s), {result.SnapshotCount} snapshot(s), and {result.FieldChangeCount} field change(s).";
        }
        catch (Exception ex)
        {
            pageMessage = ex.Message;
            pageMessageIsError = true;
        }
    }

    private string GetNextStepLabel()
        => sources.Count == 0 ? "Create first source" : "Review mappings";
}
