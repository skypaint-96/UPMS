@page "/"
@rendermode InteractiveServer

<PageTitle>UPMS</PageTitle>

<h1>UPMS</h1>

<section data-testid="dashboard-summary">
    <h2>Dashboard</h2>
    <p>Welcome to the Unified Problem Management System.</p>

    @if (isLoading)
    {
        <p>Loading statistics&hellip;</p>
    }
    else
    {
        <p>Total snapshots: <strong>@snapshotCount</strong></p>

        <p><a href="/snapshots">Browse Snapshots</a> | <a href="/reports">Reports</a></p>

        @if (recentSnapshots.Count > 0)
        {
            <h3>Recent Snapshots</h3>
            <table>
                <thead>
                    <tr>
                        <th>ITSM Source</th>
                        <th>Snapshot Date</th>
                        <th>Uploaded By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Snapshot snapshot in recentSnapshots)
                    {
                        <tr>
                            <td><a href="/snapshots/@snapshot.Id">@snapshot.ItsmSource</a></td>
                            <td>@snapshot.SnapshotDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@snapshot.UploadedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</section>

@code {
    [Inject]
    private TicketDataServiceInstance DataService { get; set; } = default!;

    private bool isLoading = true;
    private int snapshotCount = 0;
    private List<Snapshot> recentSnapshots = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IEnumerable<Snapshot> snapshots = await DataService.GetSnapshotsAsync();
            List<Snapshot> all = snapshots.ToList();
            snapshotCount = all.Count;
            recentSnapshots = all.Take(5).ToList();
        }
        catch
        {
            snapshotCount = 0;
            recentSnapshots = [];
        }
        finally
        {
            isLoading = false;
        }
    }
}
