@page "/tickets"

@using System.Globalization
@inject TicketDataServiceInstance DataService
@inject IItsmSourceService ItsmSourceService
@inject IItsmFieldMappingService FieldMappingService

<PageTitle>Tickets</PageTitle>

<h1>Tickets</h1>

<div>
    <select data-testid="itsm-source-filter" @bind="itsmSource" @bind:after="OnItsmSourceChanged">
        <option value="" disabled>-- Select ITSM Source --</option>
        @foreach (var source in itsmSources)
        {
            <option value="@source.Name">@source.DisplayLabel</option>
        }
    </select>

    <input type="datetime-local" data-testid="as-of-datetime" value="@asOfLocal" @onchange="OnAsOfLocalChanged" />

    <button data-testid="search-btn" @onclick="SearchAsync" disabled="@isLoading">Search</button>
    @if (isLoading)
    {
        <span data-testid="loading-indicator">Loading...</span>
    }
</div>

@if (string.IsNullOrWhiteSpace(itsmSource))
{
    <p data-testid="tickets-empty-hint">Select an ITSM source to begin.</p>
}
else
{
    <div data-testid="field-filters-panel">
        <h2>Field Filters</h2>
        @for (int i = 0; i < filterNames.Count; i++)
        {
            <div class="filter-row">
                <select data-testid="field-filter-name-@i" @bind="filterNames[i]">
                    <option value="" disabled>-- Field --</option>
                    @foreach (var mapping in mappings)
                    {
                        <option value="@mapping.SourceFieldName">@mapping.SourceFieldName</option>
                    }
                </select>
                <input type="text" data-testid="field-filter-value-@i" @bind="filterValues[i]" />
                <button type="button" data-testid="remove-filter-@i" @onclick="() => RemoveFilter(i)">×</button>
            </div>
        }

        <button type="button" data-testid="add-filter-btn" @onclick="AddFilter">+ Add Filter</button>
    </div>

    <table data-testid="ticket-table">
        <thead>
            <tr>
                <th>Ticket Key</th>
                <th>Company</th>
                <th>ITSM Source</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (tickets.Count == 0)
            {
                <tr data-testid="ticket-table-empty">
                    <td colspan="4">No tickets found.</td>
                </tr>
            }
            else
            {
                @foreach (var ticket in tickets)
                {
                    <tr>
                        <td><a href="/tickets/@Uri.EscapeDataString(ticket.CompanyName)/@Uri.EscapeDataString(ticket.ItsmSource)/@Uri.EscapeDataString(ticket.TicketKey)">@ticket.TicketKey</a></td>
                        <td>@ticket.CompanyName</td>
                        <td>@ticket.ItsmSource</td>
                        <td>@(ticket.Fields.TryGetValue("Status", out string? status) ? status : "—")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    private List<Ticket> tickets = new();
    private List<ItsmSource> itsmSources = new();
    private List<ItsmFieldMapping> mappings = new();
    private List<string> filterNames = new();
    private List<string> filterValues = new();

    private string itsmSource = string.Empty;
    private string asOfLocal = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm");
    private bool isLoading = false;
    private DateTime asOfDateTime = DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        await LoadItsmSourcesAsync();
    }

    private async Task LoadItsmSourcesAsync()
    {
        try
        {
            var sources = await ItsmSourceService.GetAllSourcesAsync();
            itsmSources = sources.OrderBy(s => s.DisplayLabel).ToList();
        }
        catch
        {
            itsmSources = new();
        }
    }

    private async Task OnItsmSourceChanged()
    {
        // Reset filters and tickets
        filterNames.Clear();
        filterValues.Clear();
        tickets.Clear();
        mappings.Clear();

        if (string.IsNullOrWhiteSpace(itsmSource))
            return;

        try
        {
            mappings = FieldMappingService.GetMappingsForSource(itsmSource).ToList();
        }
        catch
        {
            mappings = new();
        }

        StateHasChanged();
    }

    private void AddFilter()
    {
        filterNames.Add(string.Empty);
        filterValues.Add(string.Empty);
    }

    private void RemoveFilter(int index)
    {
        if (index < 0 || index >= filterNames.Count) return;
        filterNames.RemoveAt(index);
        filterValues.RemoveAt(index);
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(itsmSource))
            return;

        DateTime asOf;
        try
        {
            asOf = DateTime.ParseExact(asOfLocal, "yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
            asOf = DateTime.SpecifyKind(asOf, DateTimeKind.Utc);
        }
        catch
        {
            asOf = DateTime.UtcNow;
        }

        var activeFilters = new List<TicketFieldFilter>();
        for (int i = 0; i < filterNames.Count; i++)
        {
            var name = filterNames[i]?.Trim();
            var value = filterValues[i]?.Trim();
            if (!string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(value))
            {
                activeFilters.Add(new TicketFieldFilter(name, value));
            }
        }

        isLoading = true;
        try
        {
            var results = await DataService.GetTicketsFilteredAsync(itsmSource, asOf, activeFilters);
            tickets = results.ToList();
        }
        catch
        {
            tickets = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnAsOfLocalChanged(ChangeEventArgs e)
    {
        var value = e?.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(value))
        {
            if (DateTime.TryParseExact(value, "yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var dt))
            {
                asOfDateTime = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
                asOfLocal = value;
                return;
            }
            if (DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out dt))
            {
                asOfDateTime = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
                asOfLocal = value;
                return;
            }
        }
        asOfDateTime = DateTime.UtcNow;
        asOfLocal = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm");
    }
}
