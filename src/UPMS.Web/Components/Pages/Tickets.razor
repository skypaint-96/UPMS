@page "/tickets"

<PageTitle>Tickets - UPMS</PageTitle>

<h1>Tickets</h1>

<div>
    <select data-testid="company-filter" @bind="selectedCompany" @bind:after="LoadTicketsAsync">
        <option value="">All Companies</option>
        @foreach (string company in companies)
        {
            <option value="@company">@company</option>
        }
    </select>

    <select data-testid="itsm-source-filter" @bind="selectedItsmSource" @bind:after="LoadTicketsAsync">
        <option value="">All ITSM Sources</option>
        @foreach (string source in itsmSources)
        {
            <option value="@source">@source</option>
        }
    </select>
</div>

<table data-testid="ticket-table">
    <thead>
        <tr>
            <th>Ticket Key</th>
            <th>Company</th>
            <th>ITSM Source</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (tickets.Count == 0)
        {
            <tr data-testid="ticket-table-empty">
                <td colspan="4">No tickets found.</td>
            </tr>
        }
        else
        {
            @foreach (Ticket ticket in tickets)
            {
                <tr>
                    <td><a href="/tickets/@Uri.EscapeDataString(ticket.CompanyName)/@Uri.EscapeDataString(ticket.TicketKey)">@ticket.TicketKey</a></td>
                    <td>@ticket.CompanyName</td>
                    <td>@ticket.ItsmSource</td>
                    <td>@(ticket.Fields.TryGetValue("Status", out string? status) ? status : "—")</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Inject]
    private TicketDataServiceInstance DataService { get; set; } = default!;

    private List<Ticket> tickets = [];
    private List<string> companies = [];
    private List<string> itsmSources = [];
    private string selectedCompany = string.Empty;
    private string selectedItsmSource = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTicketsAsync();
    }

    private async Task LoadTicketsAsync()
    {
        try
        {
            string itsmSource = string.IsNullOrEmpty(selectedItsmSource) ? "servicenow" : selectedItsmSource;
            string company = string.IsNullOrEmpty(selectedCompany) ? "Acme Corp" : selectedCompany;

            IEnumerable<Ticket> results = await DataService.GetTicketsAsync(
                itsmSource,
                company,
                DateTime.UtcNow);

            tickets = results.ToList();
        }
        catch
        {
            tickets = [];
        }
    }
}
