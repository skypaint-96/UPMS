@page "/tickets"
@rendermode InteractiveServer

@using System.Globalization
@inject TicketDataServiceInstance DataService
@inject IItsmSourceService ItsmSourceService
@inject IItsmFieldMappingService FieldMappingService

<PageTitle>Tickets</PageTitle>

<h1>Tickets</h1>

<div class="d-flex flex-wrap gap-2 align-items-end">
    <div>
        <label class="form-label" for="itsm-source">ITSM source(s)</label>
        <select id="itsm-source" class="form-select" data-testid="itsm-source-filter" multiple size="6" @bind="selectedItsmSources" @bind:after="OnItsmSourceChanged">
            @foreach (var source in itsmSources)
            {
                <option value="@source.Name">@source.DisplayLabel</option>
            }
        </select>
        <div class="form-text">Tip: hold Ctrl/⌘ to select multiple sources.</div>
    </div>

    <div>
        <label class="form-label" for="as-of">As of</label>
        <input id="as-of"
               class="form-control"
               type="datetime-local"
               data-testid="as-of-datetime"
               value="@(_selectedAsOf.HasValue ? _selectedAsOf.Value.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture) : string.Empty)"
               @onchange="OnAsOfInputChanged" />
    </div>

    <button class="btn btn-primary" data-testid="search-btn" @onclick="SearchAsync" disabled="@(!CanSearch || isLoading)">Search</button>
    @if (isLoading)
    {
        <span class="ms-2" data-testid="loading-indicator">Loading...</span>
    }
</div>

@if (!string.IsNullOrWhiteSpace(searchError))
{
    <div class="alert alert-danger mt-3" role="alert" data-testid="tickets-search-error">
        @searchError
    </div>
}

@if (normalizedItsmSources.Count == 0)
{
    <p class="mt-3" data-testid="tickets-empty-hint">Select at least one ITSM source to begin.</p>
}
else
{
    <div class="mt-3" data-testid="field-filters-panel">
        <h2>Field Filters</h2>
        <p class="text-muted" style="max-width: 80ch">
            Filters match against the <em>canonical</em> field names for the selected ITSM source(s).
            <span class="d-block">
                Tip: <code>company</code> and <code>ticket_number</code> are always available as system fields.
            </span>
            @if (normalizedItsmSources.Count > 1)
            {
                <span class="d-block">Custom fields are available when searching multiple sources.</span>
            }
        </p>

        @if (!hasAnyMappings)
        {
            <div class="alert alert-warning" role="alert" data-testid="no-mappings-warning">
                No field mappings found for the selected ITSM source(s) yet. Add mappings on the ITSM Source page to enable canonical filtering.
            </div>
        }

        @foreach (var filter in filters)
        {
            var i = filter.Seq;
            <div class="filter-row d-flex flex-wrap gap-2 align-items-end mb-2" @key="filter.Id">
                <div>
                    <label class="form-label" for="filter-mode-@i">Type</label>
                    <select id="filter-mode-@i" class="form-select" style="max-width: 12rem" data-testid="field-filter-mode-@i" @bind="filter.Mode">
                        <option value="@FieldNameMode.Canonical">Canonical</option>
                        <option value="@FieldNameMode.Custom">Custom</option>
                    </select>
                </div>

                @if (filter.Mode == FieldNameMode.Canonical)
                {
                    <div>
                        <label class="form-label" for="filter-name-@i">Field</label>
                        <select id="filter-name-@i" class="form-select" style="min-width: 18rem" data-testid="field-filter-name-@i" @bind="filter.CanonicalFieldName">
                            <option value="" disabled>-- Field --</option>
                            @foreach (var field in availableFilterFields)
                            {
                                <option value="@field">@field</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div>
                        <label class="form-label" for="filter-custom-@i">Field</label>
                        <input id="filter-custom-@i" class="form-control" style="min-width: 18rem" type="text" placeholder="e.g. u_custom_field" data-testid="field-filter-name-@i" @bind="filter.CustomFieldName" />
                    </div>
                }

                <div>
                    <label class="form-label" for="filter-value-@i">Value</label>
                    <input id="filter-value-@i" class="form-control" style="min-width: 24rem" type="text" placeholder="contains…" data-testid="field-filter-value-@i" @bind="filter.Value" />
                </div>

                <button type="button" class="btn btn-outline-secondary" data-testid="remove-filter-@i" @onclick="() => RemoveFilter(filter)">Remove</button>
            </div>
        }

        <button type="button" class="btn btn-outline-primary" data-testid="add-filter-btn" @onclick="AddFilter">+ Add Filter</button>
        <button type="button" class="btn btn-outline-secondary ms-2" data-testid="clear-filters-btn" @onclick="ClearFilters" disabled="@(filters.Count == 0)">Clear</button>
    </div>

    @if (!searchPerformed)
    {
        <p class="text-muted mt-3" data-testid="tickets-search-hint">
            Click <strong>Search</strong> to load tickets for the selected ITSM source(s).
        </p>
    }
    else
    {
        <div class="alert alert-secondary mt-3" role="alert" data-testid="tickets-search-summary">
            Showing <strong>@tickets.Count</strong> ticket(s) from <strong>@normalizedItsmSources.Count</strong> source(s) as of <strong>@asOfDateTime.ToString("yyyy-MM-dd HH:mm")</strong>.
        </div>
    }
}

<TicketTable Tickets="tickets"
            AsOfUtc="asOfDateTime"
            TableTestId="ticket-table"
            EmptyRowTestId="ticket-table-empty"
            EmptyMessage="No tickets found."
            CanonicalFieldOptions="availableFilterFields" />

@code {
    private List<Ticket> tickets = new();
    private List<ItsmSource> itsmSources = new();
    private List<string> availableFilterFields = new();
    private List<FilterRow> filters = new();

    private string[] selectedItsmSources = Array.Empty<string>();
    private List<string> normalizedItsmSources = new();

    private string asOfLocal = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm");
    private bool isLoading = false;
    private DateTime asOfDateTime = DateTime.UtcNow;
    private string? searchError;
    private bool searchPerformed = false;

    private bool hasAnyMappings = false;

    private int nextFilterSeq = 0;

    // Backing nullable selection used for UI binding. Keep local-kind DateTime for input.
    private DateTime? _selectedAsOf = null;

    private enum FieldNameMode
    {
        Canonical,
        Custom
    }

    private sealed class FilterRow
    {
        public Guid Id { get; } = Guid.NewGuid();

        public int Seq { get; init; }

        public FieldNameMode Mode { get; set; } = FieldNameMode.Canonical;

        public string CanonicalFieldName { get; set; } = string.Empty;

        public string CustomFieldName { get; set; } = string.Empty;

        public string Value { get; set; } = string.Empty;

        public string GetEffectiveFieldName()
        {
            return Mode == FieldNameMode.Custom
                ? (CustomFieldName ?? string.Empty).Trim()
                : (CanonicalFieldName ?? string.Empty).Trim();
        }
    }

    private bool CanSearch => normalizedItsmSources.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadItsmSourcesAsync();
    }

    private async Task LoadItsmSourcesAsync()
    {
        try
        {
            var sources = await ItsmSourceService.GetAllSourcesAsync();
            itsmSources = sources.OrderBy(s => s.DisplayLabel).ToList();
        }
        catch
        {
            itsmSources = new();
        }
    }

    private async Task OnItsmSourceChanged()
    {
        // Reset filters and tickets
        filters.Clear();
        nextFilterSeq = 0;
        tickets.Clear();
        availableFilterFields.Clear();
        hasAnyMappings = false;
        searchError = null;
        searchPerformed = false;

        normalizedItsmSources = (selectedItsmSources ?? Array.Empty<string>())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s.Trim())
            .Distinct(StringComparer.Ordinal)
            .OrderBy(s => s, StringComparer.Ordinal)
            .ToList();

        if (normalizedItsmSources.Count == 0)
        {
            StateHasChanged();
            return;
        }

        try
        {
            var allMappings = new List<ItsmFieldMapping>();
            foreach (var src in normalizedItsmSources)
            {
                try
                {
                    allMappings.AddRange(FieldMappingService.GetMappingsForSource(src));
                }
                catch
                {
                    // Ignore per-source mapping failures so multi-source selection still works.
                }
            }

            // Canonical fields from mappings; treat legacy ticket_key as ticket_number.
            var canonical = allMappings
                .Select(m => m.CanonicalFieldName)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => string.Equals(n, "ticket_key", StringComparison.Ordinal) ? "ticket_number" : n!)
                .Distinct(StringComparer.Ordinal)
                .OrderBy(n => n, StringComparer.Ordinal)
                .ToList();

            hasAnyMappings = canonical.Count > 0;

            // System fields at the top (always filterable).
            var ordered = new List<string>();
            var set = new HashSet<string>(StringComparer.Ordinal);

            void Add(string name)
            {
                if (set.Add(name))
                    ordered.Add(name);
            }

            Add("ticket_number");
            Add("company");
            Add("ticket_key"); // legacy / debugging alias
            Add("status");
            foreach (var c in canonical)
                Add(c);

            availableFilterFields = ordered;
        }
        catch
        {
            availableFilterFields = new();
            hasAnyMappings = false;
        }

        // Auto-add a filter row so users immediately see the available field options.
        if (filters.Count == 0)
        {
            AddFilter();
        }

        StateHasChanged();
    }

    private void AddFilter()
    {
        filters.Add(new FilterRow { Seq = nextFilterSeq++ });
    }

    private void ClearFilters()
    {
        filters.Clear();

        nextFilterSeq = 0;

        if (availableFilterFields.Count > 0)
            AddFilter();
    }

    private void RemoveFilter(FilterRow row)
    {
        if (row is null)
            return;

        filters.Remove(row);

        if (filters.Count == 0 && availableFilterFields.Count > 0)
            AddFilter();
    }

    private async Task SearchAsync()
    {
        if (!CanSearch)
            return;

        searchError = null;
        searchPerformed = true;

        // Prefer the selected nullable backing value when present.
        DateTime asOf;
        if (_selectedAsOf.HasValue)
        {
            asOfDateTime = DateTime.SpecifyKind(_selectedAsOf.Value.ToUniversalTime(), DateTimeKind.Utc);
            asOf = asOfDateTime;
            asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
        }
        else if (TryParseAsOfUtc(asOfLocal, out var parsedUtc, out var normalizedLocal))
        {
            asOf = parsedUtc;
            asOfDateTime = parsedUtc;
            asOfLocal = normalizedLocal;
        }
        else
        {
            // Keep the last valid value.
            asOf = asOfDateTime == default ? DateTime.UtcNow : asOfDateTime;
            asOfDateTime = DateTime.SpecifyKind(asOf, DateTimeKind.Utc);
            asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
        }

        var activeFilters = new List<TicketFieldFilter>();
        foreach (var f in filters)
        {
            var name = f.GetEffectiveFieldName();
            var value = f.Value?.Trim();
            if (!string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(value))
            {
                activeFilters.Add(new TicketFieldFilter(name, value));
            }
        }

        isLoading = true;
        try
        {
            var combined = new List<Ticket>();
            var errors = new List<string>();

            foreach (var src in normalizedItsmSources)
            {
                try
                {
                    var results = await DataService.GetTicketsFilteredAsync(src, asOf, activeFilters);
                    combined.AddRange(results);
                }
                catch (Exception ex)
                {
                    errors.Add($"{src}: {ex.Message}");
                }
            }

            tickets = combined
                .OrderBy(t => t.CompanyName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(t => t.ItsmSource, StringComparer.OrdinalIgnoreCase)
                .ThenBy(t => t.TicketKey, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (errors.Count > 0)
            {
                searchError = "Some sources failed to load: " + string.Join(" | ", errors);
            }
        }
        catch (Exception ex)
        {
            tickets = new();
            searchError = $"Search failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }

        StateHasChanged();
    }

    private void OnSelectedAsOfChanged()
    {
        // Update internal UTC representations when the user changes the UI value.
        if (_selectedAsOf.HasValue)
        {
            asOfDateTime = DateTime.SpecifyKind(_selectedAsOf.Value.ToUniversalTime(), DateTimeKind.Utc);
            asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
            return;
        }

        // Do not default to "now" when the user clears or interacts with the control; leave the backing value null.
    }

    private void OnAsOfInputChanged(ChangeEventArgs e)
    {
        var str = e?.Value as string;
        if (!string.IsNullOrWhiteSpace(str))
        {
            // Parse input as local datetime in the expected format(s).
            if (DateTime.TryParseExact(str, AsOfInputFormats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedLocal))
            {
                // Treat parsed value as local time for binding.
                _selectedAsOf = DateTime.SpecifyKind(parsedLocal, DateTimeKind.Local);
                // Update internal UTC representations.
                asOfDateTime = DateTime.SpecifyKind(_selectedAsOf.Value.ToUniversalTime(), DateTimeKind.Utc);
                asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
                return;
            }

            // Lenient fallback.
            if (DateTime.TryParse(str, CultureInfo.InvariantCulture, DateTimeStyles.None, out var lenient))
            {
                _selectedAsOf = DateTime.SpecifyKind(lenient, DateTimeKind.Local);
                asOfDateTime = DateTime.SpecifyKind(_selectedAsOf.Value.ToUniversalTime(), DateTimeKind.Utc);
                asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
                return;
            }
        }

        // If cleared or invalid, leave backing null and don't set to now.
        _selectedAsOf = null;
    }

    private static readonly string[] AsOfInputFormats =
    [
        "yyyy-MM-ddTHH:mm",
        "yyyy-MM-ddTHH:mm:ss",
        "yyyy-MM-ddTHH:mm:ss.fff",
        "yyyy-MM-ddTHH:mm:ss.FFFFFFF"
    ];

    private static bool TryParseAsOfUtc(string? input, out DateTime asOfUtc, out string normalizedLocal)
    {
        asOfUtc = default;
        normalizedLocal = string.Empty;

        if (string.IsNullOrWhiteSpace(input))
            return false;

        if (DateTime.TryParseExact(
            input,
            AsOfInputFormats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out var dt))
        {
            asOfUtc = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
            normalizedLocal = asOfUtc.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
            return true;
        }

        // Final fallback: lenient parse.
        if (DateTime.TryParse(
            input,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out dt))
        {
            asOfUtc = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
            normalizedLocal = asOfUtc.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
            return true;
        }

        return false;
    }
}
