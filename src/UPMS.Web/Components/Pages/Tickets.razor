@page "/tickets"

<PageTitle>Tickets - UPMS</PageTitle>

<h1>Tickets</h1>

<div>
    <input type="text" data-testid="company-filter" placeholder="Company name" @bind="companyName" @bind:after="LoadTicketsAsync" />

    <select data-testid="itsm-source-filter" @bind="itsmSource" @bind:after="LoadTicketsAsync">
        <option value="">All ITSM Sources</option>
        @foreach (string source in itsmSources)
        {
            <option value="@source">@source</option>
        }
    </select>
</div>

@if (string.IsNullOrWhiteSpace(itsmSource) || string.IsNullOrWhiteSpace(companyName))
{
    <p data-testid="tickets-empty-hint">Enter an ITSM source and company name to browse tickets.</p>
}

<table data-testid="ticket-table">
    <thead>
        <tr>
            <th>Ticket Key</th>
            <th>Company</th>
            <th>ITSM Source</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (tickets.Count == 0)
        {
            <tr data-testid="ticket-table-empty">
                <td colspan="4">No tickets found.</td>
            </tr>
        }
        else
        {
            @foreach (Ticket ticket in tickets)
            {
                <tr>
                    <td><a href="/tickets/@Uri.EscapeDataString(ticket.CompanyName)/@Uri.EscapeDataString(ticket.ItsmSource)/@Uri.EscapeDataString(ticket.TicketKey)">@ticket.TicketKey</a></td>
                    <td>@ticket.CompanyName</td>
                    <td>@ticket.ItsmSource</td>
                    <td>@(ticket.Fields.TryGetValue("Status", out string? status) ? status : "—")</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Inject]
    private TicketDataServiceInstance DataService { get; set; } = default!;

    private List<Ticket> tickets = [];
    private List<string> itsmSources = [];
    private string companyName = string.Empty;
    private string itsmSource = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadItsmSourcesAsync();
    }

    private async Task LoadItsmSourcesAsync()
    {
        try
        {
            IEnumerable<Snapshot> snapshots = await DataService.GetSnapshotsAsync();
            itsmSources = snapshots.Select(s => s.ItsmSource).Distinct().OrderBy(s => s).ToList();
        }
        catch
        {
            itsmSources = [];
        }
    }

    private async Task LoadTicketsAsync()
    {
        if (string.IsNullOrWhiteSpace(itsmSource) || string.IsNullOrWhiteSpace(companyName))
        {
            tickets = [];
            return;
        }

        try
        {
            IEnumerable<Ticket> results = await DataService.GetTicketsAsync(
                itsmSource,
                companyName,
                DateTime.UtcNow);

            tickets = results.ToList();
        }
        catch
        {
            tickets = [];
        }
    }
}
