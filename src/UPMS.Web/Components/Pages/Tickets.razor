@page "/tickets"
@rendermode InteractiveServer

@using System.Globalization

@inject IItsmSourceService ItsmSourceService
@inject IItsmFieldMappingService FieldMappingService
@inject ICanonicalFieldService CanonicalFieldService
@inject ICanonicalValueSuggestionService CanonicalValueSuggestionService

<PageTitle>Tickets - UPMS</PageTitle>

<section class="app-page-header">
    <div>
        <p class="page-eyebrow">Ticket history</p>
        <h1 class="page-title">Tickets</h1>
        <p class="page-description">Choose one or more ITSM sources, set the point in time you want to reconstruct, and then refine the result with user-friendly canonical filters.</p>
    </div>
</section>

<section class="surface-card">
    <div class="surface-card-header">
        <div>
            <h2 class="surface-card-title">Search scope</h2>
            <p class="surface-card-subtitle">Select at least one ITSM source, choose the time you want to reconstruct, and then refine with field filters.</p>
        </div>
        @if (normalizedItsmSources.Count > 0)
        {
            <span class="badge-soft badge-soft-info">@normalizedItsmSources.Count source(s) selected</span>
        }
    </div>

    <div class="form-grid form-grid-3">
        <div class="field-stack field-stack--tall">
            <label class="form-label" for="itsm-source">ITSM source(s)</label>
            <select id="itsm-source" class="form-select" data-testid="itsm-source-filter" multiple size="6" @bind="selectedItsmSources" @bind:after="OnItsmSourceChanged">
                @foreach (var source in itsmSources)
                {
                    <option value="@source.Name">@source.DisplayLabel</option>
                }
            </select>
            <div class="form-text">Tip: hold Ctrl or Cmd to select multiple sources.</div>
        </div>

        <div class="field-stack">
            <label class="form-label" for="as-of">As of</label>
            <input id="as-of"
                   class="form-control"
                   type="datetime-local"
                   data-testid="as-of-datetime"
                   value="@asOfLocal"
                   @oninput="OnAsOfLocalChanged" />
            <div class="helper-text">UPMS returns the latest known values up to this timestamp.</div>
        </div>

        <div class="field-stack field-stack-actions">
            <button class="btn btn-primary btn-lg" data-testid="search-btn" @onclick="SearchAsync" disabled="@(!CanSearch || isLoading)">Search tickets</button>
            @if (isLoading)
            {
                <span class="text-muted" data-testid="loading-indicator">Loading...</span>
            }
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(searchError))
{
    <div class="alert alert-danger" role="alert" data-testid="tickets-search-error">
        @searchError
    </div>
}

@if (normalizedItsmSources.Count == 0)
{
    <section class="surface-card">
        <div class="empty-state" data-testid="tickets-empty-hint">
            <p class="empty-state-title">Select at least one ITSM source to begin</p>
            <p class="empty-state-text">Once you choose a source, UPMS will reveal the field filters available for that mapping.</p>
        </div>
    </section>
}
else
{
    <section class="surface-card" data-testid="field-filters-panel">
        <div class="surface-card-header">
            <div>
                <h2 class="surface-card-title">Field filters</h2>
                <p class="surface-card-subtitle">
                    Filters use the <em>canonical</em> field names configured for the selected ITSM source(s). Where UPMS knows the field type, the value control becomes more helpful automatically.
                    @if (normalizedItsmSources.Count > 1)
                    {
                        <span class="d-block mt-1">Custom field matching is also available when searching multiple sources.</span>
                    }
                </p>
            </div>
            <div class="button-row">
                <span class="badge-soft badge-soft-neutral">@filters.Count row(s)</span>
                <button type="button" class="btn btn-outline-primary" data-testid="add-filter-btn" @onclick="AddFilter">Add filter</button>
                <button type="button" class="btn btn-outline-secondary" data-testid="clear-filters-btn" @onclick="ClearFilters" disabled="@(filters.Count == 0)">Clear all</button>
            </div>
        </div>

        @if (!hasAnyMappings)
        {
            <div class="alert alert-warning" role="alert" data-testid="no-mappings-warning">
                No field mappings were found for the selected ITSM source(s). Add mappings on the ITSM Source page to enable richer canonical filtering.
            </div>
        }

        <div class="column-manager-grid">
            @foreach (var filter in filters)
            {
                var i = filter.Seq;
                var suggestionListId = GetSuggestionListId(filter);
                var suggestions = filter.Suggestions;
                var hasFilterDataType = TryGetFilterDataType(filter, out var filterDataType);
                <div class="filter-row-card" @key="filter.Id">
                    <div class="form-grid" style="grid-template-columns: minmax(160px, 220px) minmax(220px, 1fr) minmax(260px, 1.2fr) auto; align-items: end;">
                        <div class="field-stack">
                            <label class="form-label" for="filter-mode-@i">Type</label>
                            <select id="filter-mode-@i" class="form-select" data-testid="field-filter-mode-@i" @bind="filter.Mode" @bind:after="() => OnFilterModeChangedAsync(filter)">
                                <option value="@FieldNameMode.Canonical">Canonical</option>
                                <option value="@FieldNameMode.Custom">Custom</option>
                            </select>
                        </div>

                        @if (filter.Mode == FieldNameMode.Canonical)
                        {
                            <div class="field-stack">
                                <label class="form-label" for="filter-name-@i">Field</label>
                                <select id="filter-name-@i" class="form-select" data-testid="field-filter-name-@i" @bind="filter.CanonicalFieldName" @bind:after="() => OnCanonicalFieldChangedAsync(filter)">
                                    <option value="">-- Field --</option>
                                    @foreach (var field in availableFilterFields)
                                    {
                                        <option value="@field">@field</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="field-stack">
                                <label class="form-label" for="filter-custom-@i">Field</label>
                                <input id="filter-custom-@i" class="form-control" type="text" placeholder="e.g. u_custom_field" data-testid="field-filter-name-@i" @bind="filter.CustomFieldName" />
                            </div>
                        }

                        <div class="field-stack">
                            <label class="form-label" for="filter-value-@i">Value</label>
                            @if (filter.Mode == FieldNameMode.Canonical && hasFilterDataType && filterDataType == CanonicalFieldDataType.Boolean)
                            {
                                <select id="filter-value-@i" class="form-select" data-testid="field-filter-value-@i" @bind="filter.Value">
                                    <option value="">-- Select --</option>
                                    <option value="true">True</option>
                                    <option value="false">False</option>
                                </select>
                            }
                            else if (filter.Mode == FieldNameMode.Canonical && hasFilterDataType && filterDataType == CanonicalFieldDataType.DateTime)
                            {
                                <input id="filter-value-@i" class="form-control" type="datetime-local" placeholder="Choose a date/time" data-testid="field-filter-value-@i" value="@filter.Value" @onchange="e => filter.Value = e.Value?.ToString() ?? string.Empty" />
                            }
                            else if (filter.Mode == FieldNameMode.Canonical && hasFilterDataType && (filterDataType == CanonicalFieldDataType.Integer || filterDataType == CanonicalFieldDataType.Decimal))
                            {
                                <input id="filter-value-@i" class="form-control" type="number" step="@(filterDataType == CanonicalFieldDataType.Decimal ? "0.01" : "1")" placeholder="Enter a value" data-testid="field-filter-value-@i" value="@filter.Value" @onchange="e => filter.Value = e.Value?.ToString() ?? string.Empty" />
                            }
                            else
                            {
                                <input id="filter-value-@i"
                                       class="form-control"
                                       type="text"
                                       placeholder="@GetFilterValuePlaceholder(filter)"
                                       data-testid="field-filter-value-@i"
                                       list="@(ShouldUseSuggestionList(filter) && suggestions.Count > 0 ? suggestionListId : null)"
                                       value="@filter.Value"
                                       @onfocus="() => LoadSuggestionsAsync(filter)"
                                       @onchange="e => filter.Value = e.Value?.ToString() ?? string.Empty" />

                                @if (ShouldUseSuggestionList(filter) && suggestions.Count > 0)
                                {
                                    <datalist id="@suggestionListId">
                                        @foreach (var suggestion in suggestions)
                                        {
                                            <option value="@suggestion"></option>
                                        }
                                    </datalist>
                                }
                            }
                        </div>

                        <div class="field-stack">
                            <button type="button" class="btn btn-outline-secondary" data-testid="remove-filter-@i" @onclick="() => RemoveFilter(filter)">Remove</button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!searchPerformed)
        {
            <p class="text-muted mt-3 mb-0" data-testid="tickets-search-hint">Click <strong>Search tickets</strong> to load results for the selected ITSM source(s).</p>
        }
        else
        {
            <div class="alert alert-secondary mt-3 mb-0" role="alert" data-testid="tickets-search-summary">
                Showing <strong>@tickets.Count</strong> ticket(s) from <strong>@normalizedItsmSources.Count</strong> source(s) as of <strong>@asOfDateTime.ToString("yyyy-MM-dd HH:mm")</strong> UTC.
            </div>
        }
    </section>
}

<section class="surface-card">
    <div class="surface-card-header">
        <div>
            <h2 class="surface-card-title">Results</h2>
            <p class="surface-card-subtitle">Open any ticket to inspect its reconstructed field state and change history.</p>
        </div>
    </div>

    <TicketTable Tickets="tickets"
                AsOfUtc="asOfDateTime"
                TableTestId="ticket-table"
                EmptyRowTestId="ticket-table-empty"
                EmptyMessage="No tickets found."
                CanonicalFieldOptions="availableFilterFields" />
</section>

@code {
    [SupplyParameterFromQuery(Name = "source")]
    public string? QueryItsmSource { get; set; }

    [SupplyParameterFromQuery(Name = "ticket")]
    public string? QueryTicket { get; set; }

    private List<Ticket> tickets = new();
    private List<ItsmSource> itsmSources = new();
    private List<string> availableFilterFields = new();
    private List<FilterRow> filters = new();
    private IReadOnlyDictionary<string, CanonicalFieldDefinition> canonicalFieldLookup = new Dictionary<string, CanonicalFieldDefinition>(StringComparer.OrdinalIgnoreCase);

    private string[] selectedItsmSources = Array.Empty<string>();
    private List<string> normalizedItsmSources = new();

    private string asOfLocal = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm");
    private bool isLoading;
    private bool initialized;
    private DateTime asOfDateTime = DateTime.UtcNow;
    private string? searchError;
    private bool searchPerformed;
    private bool hasAnyMappings;
    private int nextFilterSeq;
    private string? lastAppliedQuerySignature;

    private enum FieldNameMode
    {
        Canonical,
        Custom
    }

    private sealed class FilterRow
    {
        public Guid Id { get; } = Guid.NewGuid();
        public int Seq { get; init; }
        public FieldNameMode Mode { get; set; } = FieldNameMode.Canonical;
        public string CanonicalFieldName { get; set; } = string.Empty;
        public string CustomFieldName { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
        public IReadOnlyList<string> Suggestions { get; set; } = Array.Empty<string>();

        public string GetEffectiveFieldName()
        {
            return Mode == FieldNameMode.Custom
                ? (CustomFieldName ?? string.Empty).Trim()
                : (CanonicalFieldName ?? string.Empty).Trim();
        }
    }

    private bool CanSearch => normalizedItsmSources.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadItsmSourcesAsync();
        await LoadCanonicalFieldsAsync();
        initialized = true;
        await ApplyQueryStateAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!initialized)
            return;

        await ApplyQueryStateAsync();
    }

    private async Task LoadItsmSourcesAsync()
    {
        try
        {
            itsmSources = (await ItsmSourceService.GetAllSourcesAsync())
                .OrderBy(s => s.DisplayLabel)
                .ThenBy(s => s.Name)
                .ToList();
        }
        catch
        {
            itsmSources = new();
        }
    }

    private async Task LoadCanonicalFieldsAsync()
    {
        try
        {
            canonicalFieldLookup = await CanonicalFieldService.GetLookupAsync();
        }
        catch
        {
            canonicalFieldLookup = new Dictionary<string, CanonicalFieldDefinition>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task ApplyQueryStateAsync()
    {
        string signature = $"{QueryItsmSource?.Trim()}|{QueryTicket?.Trim()}";
        if (string.Equals(signature, lastAppliedQuerySignature, StringComparison.Ordinal))
            return;

        lastAppliedQuerySignature = signature;

        if (string.IsNullOrWhiteSpace(QueryItsmSource))
            return;

        selectedItsmSources = [QueryItsmSource.Trim()];
        await OnItsmSourceChanged();

        if (!string.IsNullOrWhiteSpace(QueryTicket))
        {
            if (filters.Count == 0)
                AddFilter();

            var firstFilter = filters[0];
            firstFilter.Mode = FieldNameMode.Canonical;
            firstFilter.CanonicalFieldName = "Number";
            firstFilter.Value = QueryTicket.Trim();
            firstFilter.Suggestions = Array.Empty<string>();
        }

        if (CanSearch)
        {
            await SearchAsync();
        }
    }

    private async Task OnItsmSourceChanged()
    {
        filters.Clear();
        nextFilterSeq = 0;
        tickets.Clear();
        availableFilterFields.Clear();
        hasAnyMappings = false;
        searchError = null;
        searchPerformed = false;

        normalizedItsmSources = (selectedItsmSources ?? Array.Empty<string>())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (normalizedItsmSources.Count == 0)
        {
            StateHasChanged();
            return;
        }

        try
        {
            var allMappings = new List<ItsmFieldMapping>();
            foreach (var src in normalizedItsmSources)
            {
                try
                {
                    allMappings.AddRange(FieldMappingService.GetMappingsForSource(src));
                }
                catch
                {
                }
            }

            var canonical = allMappings
                .Select(m => NormalizeUiCanonicalFieldName(m.CanonicalFieldName))
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                .ToList();

            hasAnyMappings = canonical.Count > 0;

            var ordered = new List<string>();
            var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            void Add(string name)
            {
                if (!string.IsNullOrWhiteSpace(name) && set.Add(name))
                    ordered.Add(name);
            }

            Add("Number");
            Add("Company");
            Add("State");
            foreach (var c in canonical)
                Add(c);

            availableFilterFields = ordered;
        }
        catch
        {
            availableFilterFields = new();
            hasAnyMappings = false;
        }

        if (filters.Count == 0)
        {
            AddFilter();
        }

        StateHasChanged();
    }

    private void AddFilter()
    {
        filters.Add(new FilterRow { Seq = nextFilterSeq++ });
    }

    private void ClearFilters()
    {
        filters.Clear();
        nextFilterSeq = 0;

        if (availableFilterFields.Count > 0)
            AddFilter();
    }

    private void RemoveFilter(FilterRow row)
    {
        if (row is null)
            return;

        filters.Remove(row);

        if (filters.Count == 0 && availableFilterFields.Count > 0)
            AddFilter();
    }

    private async Task OnFilterModeChangedAsync(FilterRow row)
    {
        row.CanonicalFieldName = string.Empty;
        row.CustomFieldName = string.Empty;
        row.Value = string.Empty;
        row.Suggestions = Array.Empty<string>();
        await Task.CompletedTask;
    }

    private async Task OnCanonicalFieldChangedAsync(FilterRow row)
    {
        row.Value = string.Empty;
        row.Suggestions = Array.Empty<string>();
        await LoadSuggestionsAsync(row);
    }

    private async Task LoadSuggestionsAsync(FilterRow row)
    {
        if (!ShouldUseSuggestionList(row))
            return;

        var fieldName = NormalizeUiCanonicalFieldName(row.CanonicalFieldName);
        row.Suggestions = await CanonicalValueSuggestionService.GetSuggestionsAsync(fieldName, normalizedItsmSources);
        StateHasChanged();
    }

    private async Task SearchAsync()
    {
        if (!CanSearch)
            return;

        searchError = null;
        searchPerformed = true;

        DateTime asOf;
        if (TryParseAsOfUtc(asOfLocal, out var parsedUtc, out var normalizedLocal))
        {
            asOf = parsedUtc;
            asOfDateTime = parsedUtc;
            asOfLocal = normalizedLocal;
        }
        else
        {
            asOf = asOfDateTime == default ? DateTime.UtcNow : asOfDateTime;
            asOfDateTime = DateTime.SpecifyKind(asOf, DateTimeKind.Utc);
            asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
        }

        var activeFilters = new List<TicketFieldFilter>();
        foreach (var f in filters)
        {
            var name = NormalizeUiCanonicalFieldName(f.GetEffectiveFieldName());
            var value = f.Value?.Trim();
            if (!string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(value))
            {
                activeFilters.Add(new TicketFieldFilter(name, value, GetFilterDataTypeOrNull(f)));
            }
        }

        isLoading = true;
        try
        {
            var combined = new List<Ticket>();
            var errors = new List<string>();

            foreach (var src in normalizedItsmSources)
            {
                try
                {
                    var results = await DataService.GetTicketsFilteredAsync(src, asOf, activeFilters);
                    combined.AddRange(results);
                }
                catch (Exception ex)
                {
                    errors.Add($"{src}: {ex.Message}");
                }
            }

            tickets = combined
                .OrderBy(t => t.CompanyName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(t => t.ItsmSource, StringComparer.OrdinalIgnoreCase)
                .ThenBy(t => t.TicketKey, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (errors.Count > 0)
            {
                searchError = "Some sources failed to load: " + string.Join(" | ", errors);
            }
        }
        catch (Exception ex)
        {
            tickets = new();
            searchError = $"Search failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }

        StateHasChanged();
    }

    private void OnAsOfLocalChanged(ChangeEventArgs args)
    {
        asOfLocal = args.Value?.ToString() ?? string.Empty;

        if (TryParseAsOfUtc(asOfLocal, out var parsedUtc, out var normalizedLocal))
        {
            asOfDateTime = parsedUtc;
            asOfLocal = normalizedLocal;
            return;
        }

        if (string.IsNullOrWhiteSpace(asOfLocal))
        {
            asOfDateTime = DateTime.UtcNow;
            asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
        }
    }

    private bool ShouldUseSuggestionList(FilterRow filter)
    {
        return filter.Mode == FieldNameMode.Canonical
            && !string.IsNullOrWhiteSpace(filter.CanonicalFieldName)
            && GetFilterDataTypeOrNull(filter) == CanonicalFieldDataType.Text;
    }

    private string GetSuggestionListId(FilterRow filter) => $"filter-suggestions-{filter.Seq}";

    private string GetFilterValuePlaceholder(FilterRow filter)
    {
        var field = NormalizeUiCanonicalFieldName(filter.CanonicalFieldName);
        return field switch
        {
            "Company" => "Start typing to see known companies",
            "Number" => "Ticket number, for example PRB0012345",
            _ => "Contains value"
        };
    }

    private CanonicalFieldDataType? GetFilterDataTypeOrNull(FilterRow filter)
    {
        if (filter.Mode != FieldNameMode.Canonical)
            return null;

        return TryGetFilterDataType(filter, out var dataType)
            ? dataType
            : null;
    }

    private bool TryGetFilterDataType(FilterRow filter, out CanonicalFieldDataType dataType)
    {
        dataType = CanonicalFieldDataType.Text;
        if (filter.Mode != FieldNameMode.Canonical)
            return false;

        string fieldName = NormalizeUiCanonicalFieldName(filter.CanonicalFieldName);
        if (string.IsNullOrWhiteSpace(fieldName))
            return false;

        if (canonicalFieldLookup.TryGetValue(fieldName, out var definition))
        {
            dataType = definition.DataType;
            return true;
        }

        return fieldName is "Number" or "Company" or "State";
    }

    private static string NormalizeUiCanonicalFieldName(string? fieldName)
    {
        if (string.IsNullOrWhiteSpace(fieldName))
            return string.Empty;

        string trimmed = fieldName.Trim();
        return trimmed.ToLowerInvariant() switch
        {
            "ticket_number" => "Number",
            "ticket_key" => "Number",
            "number" => "Number",
            "company" => "Company",
            "company_name" => "Company",
            "status" => "State",
            _ => trimmed
        };
    }

    private static readonly string[] AsOfInputFormats =
    [
        "yyyy-MM-ddTHH:mm",
        "yyyy-MM-ddTHH:mm:ss",
        "yyyy-MM-ddTHH:mm:ss.fff",
        "yyyy-MM-ddTHH:mm:ss.FFFFFFF"
    ];

    private static bool TryParseAsOfUtc(string? input, out DateTime asOfUtc, out string normalizedLocal)
    {
        asOfUtc = default;
        normalizedLocal = string.Empty;

        if (string.IsNullOrWhiteSpace(input))
            return false;

        if (DateTime.TryParseExact(
            input,
            AsOfInputFormats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out var dt))
        {
            asOfUtc = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
            normalizedLocal = asOfUtc.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
            return true;
        }

        if (DateTime.TryParse(
            input,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out dt))
        {
            asOfUtc = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
            normalizedLocal = asOfUtc.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
            return true;
        }

        return false;
    }
}
