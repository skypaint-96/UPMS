@page "/tickets"
@rendermode InteractiveServer

@using System.Globalization
@inject TicketDataServiceInstance DataService
@inject IItsmSourceService ItsmSourceService
@inject IItsmFieldMappingService FieldMappingService

<PageTitle>Tickets</PageTitle>

<h1>Tickets</h1>

<div class="d-flex flex-wrap gap-2 align-items-end">
    <div>
        <label class="form-label" for="itsm-source">ITSM source</label>
        <select id="itsm-source" class="form-select" data-testid="itsm-source-filter" @bind="itsmSource" @bind:after="OnItsmSourceChanged">
            <option value="" disabled>-- Select ITSM Source --</option>
            @foreach (var source in itsmSources)
            {
                <option value="@source.Name">@source.DisplayLabel</option>
            }
        </select>
    </div>

    <div>
        <label class="form-label" for="as-of">As of</label>
        <input id="as-of" class="form-control" type="datetime-local" data-testid="as-of-datetime" value="@asOfLocal" @onchange="OnAsOfLocalChanged" />
    </div>

    <button class="btn btn-primary" data-testid="search-btn" @onclick="SearchAsync" disabled="@(!CanSearch || isLoading)">Search</button>
    @if (isLoading)
    {
        <span class="ms-2" data-testid="loading-indicator">Loading...</span>
    }
</div>

@if (!string.IsNullOrWhiteSpace(searchError))
{
    <div class="alert alert-danger mt-3" role="alert" data-testid="tickets-search-error">
        @searchError
    </div>
}

@if (string.IsNullOrWhiteSpace(itsmSource))
{
    <p class="mt-3" data-testid="tickets-empty-hint">Select an ITSM source to begin.</p>
}
else
{
    <div class="mt-3" data-testid="field-filters-panel">
        <h2>Field Filters</h2>
        <p class="text-muted" style="max-width: 80ch">
            Filters match against the <em>canonical</em> field names for this ITSM source.
            <span class="d-block">
                Tip: <code>company</code> and <code>ticket_number</code> are always available as system fields.
            </span>
        </p>

        @if (availableFilterFields.Count == 0)
        {
            <div class="alert alert-warning" role="alert" data-testid="no-mappings-warning">
                No field mappings found for this ITSM source yet. Add mappings on the ITSM Source page to enable filtering.
            </div>
        }

        @{ var rowIndex = 0; }
        @foreach (var filter in filters)
        {
            var i = rowIndex++;
            <div class="filter-row d-flex flex-wrap gap-2 align-items-center mb-2" @key="filter.Id">
                <select class="form-select" style="max-width: 18rem" data-testid="field-filter-name-@i" @bind="filter.FieldName">
                    <option value="" disabled>-- Field --</option>
                    @foreach (var field in availableFilterFields)
                    {
                        <option value="@field">@field</option>
                    }
                </select>
                <input class="form-control" style="max-width: 24rem" type="text" placeholder="contains…" data-testid="field-filter-value-@i" @bind="filter.Value" />
                <button type="button" class="btn btn-outline-secondary" data-testid="remove-filter-@i" @onclick="() => RemoveFilter(filter)">Remove</button>
            </div>
        }

        <button type="button" class="btn btn-outline-primary" data-testid="add-filter-btn" @onclick="AddFilter" disabled="@(availableFilterFields.Count == 0)">+ Add Filter</button>
        <button type="button" class="btn btn-outline-secondary ms-2" data-testid="clear-filters-btn" @onclick="ClearFilters" disabled="@(filters.Count == 0)">Clear</button>
    </div>

    @if (!searchPerformed)
    {
        <p class="text-muted mt-3" data-testid="tickets-search-hint">
            Click <strong>Search</strong> to load tickets for the selected ITSM source.
        </p>
    }
    else
    {
        <div class="alert alert-secondary mt-3" role="alert" data-testid="tickets-search-summary">
            Showing <strong>@tickets.Count</strong> ticket(s) as of <strong>@asOfDateTime.ToString("yyyy-MM-dd HH:mm")</strong>.
        </div>

        <table class="table table-striped table-hover" data-testid="ticket-table">
            <thead>
                <tr>
                    <th>Ticket Key</th>
                    <th>Company</th>
                    <th>ITSM Source</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (tickets.Count == 0)
                {
                    <tr data-testid="ticket-table-empty">
                        <td colspan="4">No tickets found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var ticket in tickets)
                    {
                        var ticketNumber = TryGetFieldValue(ticket.Fields, "ticket_number");
                        var status = TryGetFieldValue(ticket.Fields, "status");
                        <tr>
                            <td>
                                <a href="/tickets/@Uri.EscapeDataString(ticket.CompanyName)/@Uri.EscapeDataString(ticket.ItsmSource)/@Uri.EscapeDataString(ticket.TicketKey)?asOf=@Uri.EscapeDataString(asOfLocal)">@(ticketNumber ?? ticket.TicketKey)</a>
                                @if (!string.IsNullOrWhiteSpace(ticketNumber) && !string.Equals(ticketNumber, ticket.TicketKey, StringComparison.Ordinal))
                                {
                                    <div class="text-muted small">@ticket.TicketKey</div>
                                }
                            </td>
                            <td>@ticket.CompanyName</td>
                            <td>@ticket.ItsmSource</td>
                            <td>@(string.IsNullOrWhiteSpace(status) ? "—" : status)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
}

@code {
    private List<Ticket> tickets = new();
    private List<ItsmSource> itsmSources = new();
    private List<ItsmFieldMapping> mappings = new();
    private List<string> availableFilterFields = new();
    private List<FilterRow> filters = new();

    private string itsmSource = string.Empty;
    private string asOfLocal = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm");
    private bool isLoading = false;
    private DateTime asOfDateTime = DateTime.UtcNow;
    private string? searchError;
    private bool searchPerformed = false;

    private sealed class FilterRow
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string FieldName { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    private bool CanSearch => !string.IsNullOrWhiteSpace(itsmSource);

    protected override async Task OnInitializedAsync()
    {
        await LoadItsmSourcesAsync();
    }

    private async Task LoadItsmSourcesAsync()
    {
        try
        {
            var sources = await ItsmSourceService.GetAllSourcesAsync();
            itsmSources = sources.OrderBy(s => s.DisplayLabel).ToList();
        }
        catch
        {
            itsmSources = new();
        }
    }

    private async Task OnItsmSourceChanged()
    {
        // Reset filters and tickets
        filters.Clear();
        tickets.Clear();
        mappings.Clear();
        availableFilterFields.Clear();
        searchError = null;
        searchPerformed = false;

        if (string.IsNullOrWhiteSpace(itsmSource))
            return;

        try
        {
            mappings = FieldMappingService.GetMappingsForSource(itsmSource).ToList();

            // Canonical fields from mappings; treat legacy ticket_key as ticket_number.
            var canonical = mappings
                .Select(m => m.CanonicalFieldName)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => string.Equals(n, "ticket_key", StringComparison.Ordinal) ? "ticket_number" : n!)
                .Distinct(StringComparer.Ordinal)
                .OrderBy(n => n, StringComparer.Ordinal)
                .ToList();

            // System fields at the top (always filterable).
            var ordered = new List<string>();
            var set = new HashSet<string>(StringComparer.Ordinal);

            void Add(string name)
            {
                if (set.Add(name))
                    ordered.Add(name);
            }

            Add("ticket_number");
            Add("company");
            Add("ticket_key"); // legacy / debugging alias
            foreach (var c in canonical)
                Add(c);

            availableFilterFields = ordered;
        }
        catch
        {
            mappings = new();
            availableFilterFields = new();
        }

        // Auto-add a filter row so users immediately see the available field options.
        if (filters.Count == 0 && availableFilterFields.Count > 0)
        {
            AddFilter();
        }

        StateHasChanged();
    }

    private void AddFilter()
    {
        filters.Add(new FilterRow());
    }

    private void ClearFilters()
    {
        filters.Clear();

        if (availableFilterFields.Count > 0)
            AddFilter();
    }

    private void RemoveFilter(FilterRow row)
    {
        if (row is null)
            return;

        filters.Remove(row);

        if (filters.Count == 0 && availableFilterFields.Count > 0)
            AddFilter();
    }

    private async Task SearchAsync()
    {
        if (!CanSearch)
            return;

        searchError = null;
        searchPerformed = true;

        // NOTE:
        // <input type="datetime-local"> values can legally include seconds (and even fractional seconds)
        // depending on browser/OS settings. If we parse too strictly here, we'll fall back to UtcNow and
        // the "As of" filter will appear to do nothing (always showing the latest values).
        //
        // We therefore parse leniently and then normalise back to the canonical "yyyy-MM-ddTHH:mm" format.
        DateTime asOf = ParseAsOfUtc(asOfLocal, fallbackUtc: asOfDateTime);
        asOfDateTime = asOf;
        asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm");

        var activeFilters = new List<TicketFieldFilter>();
        foreach (var f in filters)
        {
            var name = f.FieldName?.Trim();
            var value = f.Value?.Trim();
            if (!string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(value))
            {
                activeFilters.Add(new TicketFieldFilter(name, value));
            }
        }

        isLoading = true;
        try
        {
            var results = await DataService.GetTicketsFilteredAsync(itsmSource, asOf, activeFilters);
            tickets = results.ToList();
        }
        catch (Exception ex)
        {
            tickets = new();
            searchError = $"Search failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }

        StateHasChanged();
    }

    private static string? TryGetFieldValue(IDictionary<string, string?> fields, string fieldName)
    {
        if (fields.TryGetValue(fieldName, out var v))
            return v;

        // Cheap case-insensitive fallback (dictionary is Ordinal in most of our paths)
        foreach (var kv in fields)
        {
            if (string.Equals(kv.Key, fieldName, StringComparison.OrdinalIgnoreCase))
                return kv.Value;
        }

        return null;
    }

    private void OnAsOfLocalChanged(ChangeEventArgs e)
    {
        var value = e?.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(value))
        {
            // Keep the UI tolerant of seconds/fractional seconds, but normalise what we store.
            var parsed = ParseAsOfUtc(value, fallbackUtc: asOfDateTime);
            asOfDateTime = parsed;
            asOfLocal = asOfDateTime.ToString("yyyy-MM-ddTHH:mm");
            return;
        }
        asOfDateTime = DateTime.UtcNow;
        asOfLocal = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm");
    }

    private static readonly string[] AsOfInputFormats =
    {
        // Standard datetime-local value format (minutes)
        "yyyy-MM-ddTHH:mm",
        // Some browsers include seconds
        "yyyy-MM-ddTHH:mm:ss",
        // Some browsers include fractional seconds (milliseconds)
        "yyyy-MM-ddTHH:mm:ss.fff",
        // Be permissive in case fractional seconds are longer
        "yyyy-MM-ddTHH:mm:ss.FFFFFFF",
    };

    private static DateTime ParseAsOfUtc(string? input, DateTime fallbackUtc)
    {
        if (!string.IsNullOrWhiteSpace(input))
        {
            // Try exact formats first (fast + avoids locale surprises)
            if (DateTime.TryParseExact(
                    input,
                    AsOfInputFormats,
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
                    out var dtExact))
            {
                return DateTime.SpecifyKind(dtExact, DateTimeKind.Utc);
            }

            // Fall back to a broader parse (still invariant + assume UTC)
            if (DateTime.TryParse(
                    input,
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
                    out var dt))
            {
                return DateTime.SpecifyKind(dt, DateTimeKind.Utc);
            }
        }

        // If the input can't be parsed, keep the last-known value rather than forcing "now".
        // This avoids the UX trap where any invalid string silently becomes "most recent".
        return fallbackUtc.Kind == DateTimeKind.Utc ? fallbackUtc : DateTime.SpecifyKind(fallbackUtc, DateTimeKind.Utc);
    }
}
