{
  "Auth": {
    "Mode": "ApiKey",
    "ApiKey": {
      "HeaderName": "X-UPMS-API-Key",
      "Keys": [
        {
          "Name": "local-dev",
          "Value": "upms-dev-key",
          "Roles": [ "upms-reader", "upms-writer" ]
        }
      ]
    }
  },
  "Artifacts": {
    "RootPath": "/var/lib/upms"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
