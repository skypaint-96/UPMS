{
  "Auth": {
    "Mode": "None"
  },
  "Artifacts": {
    "RootPath": "/var/lib/upms"
  },
  "FileSharePolling": {
    "Enabled": false,
    "AllowUserManagedSources": true,
    "SchedulerIntervalSeconds": 30,
    "DefaultPollIntervalSeconds": 300,
    "MinPollIntervalSeconds": 60,
    "MaxPollIntervalSeconds": 86400,
    "DefaultStableFileAgeSeconds": 30,
    "MaxFilesPerCycleCap": 100,
    "AllowedWatchedRoots": [
      "/mnt/upms/inbound"
    ],
    "AllowedArchiveRoots": [
      "/mnt/upms/archive"
    ],
    "AllowedErrorRoots": [
      "/mnt/upms/quarantine"
    ]
  }
}
