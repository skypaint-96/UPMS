{
  "Artifacts": {
    "RootPath": "/var/lib/upms"
  },
  "Worker": {
    "PollIntervalSeconds": 5,
    "LeaseDurationSeconds": 120
  },
  "FileSharePolling": {
    "Enabled": false,
    "PollIntervalSeconds": 60,
    "WatchedPath": "",
    "FilePatterns": [ "*.csv", "*.json" ],
    "ArchivePath": "",
    "ErrorPath": "",
    "MaxFilesPerCycle": 25,
    "ItsmSource": "",
    "StableFileAgeSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
